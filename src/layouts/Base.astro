---
import '@fontsource-variable/onest';
import '@fontsource-variable/unbounded';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import unboundedLatin from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description?: string;
  /** Which top-nav item is highlighted. */
  current?: 'Home' | 'Library' | 'Membership' | 'About' | 'Contact' | '';
  /** Absolute or root-relative path to an Open Graph image. */
  image?: ImageMetadata | string;
  /** Set for pages that should not be indexed (thank-you, download). */
  noindex?: boolean;
  /** Extra JSON-LD to inject. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  current = '',
  image,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageSrc = typeof image === 'string' ? image : image?.src ?? '/favicon-512.png';
const ogImage = new URL(ogImageSrc, Astro.site ?? Astro.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f3ee" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={unboundedLatin} as="font" type="font/woff2" crossorigin />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {
      gaId && (
        <Fragment>
          {/* Google Consent Mode v2: everything denied until the visitor accepts in the banner. */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
            try {
              if (localStorage.getItem('cookie-consent') === 'granted') {
                gtag('consent', 'update', { analytics_storage: 'granted' });
              }
            } catch (e) {}
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          </script>
        </Fragment>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Footer />
    {gaId && <CookieConsent />}
  </body>
</html>
