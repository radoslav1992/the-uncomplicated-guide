---
import '@fontsource-variable/onest';
import '@fontsource-variable/unbounded';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import unboundedLatin from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description?: string;
  /** Which top-nav item is highlighted. */
  current?: 'Home' | 'Library' | 'Blog' | 'About' | 'Contact' | '';
  /** Absolute or root-relative path to an Open Graph image. */
  image?: ImageMetadata | string;
  /** Set for pages that should not be indexed (thank-you, download). */
  noindex?: boolean;
  /**
   * Set on blog posts. Switches the page to `og:type=article` and adds the
   * published/modified times and tags that social cards and readers use.
   */
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  /** Extra JSON-LD to inject. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  current = '',
  image,
  noindex = false,
  article,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageSrc = typeof image === 'string' ? image : image?.src ?? '/social/default.png';
const ogImage = new URL(ogImageSrc, Astro.site ?? Astro.url).href;
// Dimensions let a scraper lay the card out before it has fetched the file.
const ogImageSize = ogImageSrc.startsWith('/social/') ? {width:1200,height:630} : typeof image === 'string' || !image ? null : { width: image.width, height: image.height };
// Guide covers are portrait and the fallback is a square logo; a wide card would
// crop either to an unreadable horizontal slice. Only genuinely landscape art
// earns `summary_large_image`.
const wideCard = ogImageSize ? ogImageSize.width / ogImageSize.height >= 1.5 : false;
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const gaId = noindex ? '' : import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — blog`} href="/rss.xml" />
    <meta name="theme-color" content="#f6f3ee" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogImageSize && (
        <Fragment>
          <meta property="og:image:width" content={String(ogImageSize.width)} />
          <meta property="og:image:height" content={String(ogImageSize.height)} />
        </Fragment>
      )
    }
    {
      article && (
        <Fragment>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
          )}
          <meta property="article:author" content={site.author.name} />
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </Fragment>
      )
    }
    <meta name="author" content={site.author.name} />
    <meta name="twitter:card" content={wideCard ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={unboundedLatin} as="font" type="font/woff2" crossorigin />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){window.dataLayer.push(arguments);};
      let analyticsStarted = false;
      const permitted = () => { try { return localStorage.getItem('cookie-consent') === 'granted'; } catch { return false; } };
      const start = () => {
        if (analyticsStarted || !permitted()) return;
        analyticsStarted = true;
        gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'granted'});
        gtag('js',new Date());
        gtag('config',gaId,{send_page_view:false,page_location:location.origin+location.pathname,page_referrer:''});
        gtag('event','page_view');
        const script=document.createElement('script');script.async=true;script.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(gaId);document.head.appendChild(script);
        const match=location.pathname.match(/^\/guides\/([^/]+)$/);
        if(match) gtag('event','view_item',{item_id:match[1]});
      };
      document.addEventListener('cookie-consent:changed',start);
      document.addEventListener('click',event=>{
        const link=event.target instanceof Element ? event.target.closest('[data-track]') : null;
        if(link && permitted()) gtag('event',link.getAttribute('data-track'),{item_id:link.getAttribute('data-guide')});
      });
      start();
    </script>}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header current={current} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {gaId && <CookieConsent />}
  </body>
</html>
