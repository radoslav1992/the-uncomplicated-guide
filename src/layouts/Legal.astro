---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <article class="legal">
    <p class="eyebrow">Legal</p>
    <h1>{title}</h1>
    <p class="updated">Last updated: {site.legalUpdated}</p>
    <slot />
  </article>
</Base>
