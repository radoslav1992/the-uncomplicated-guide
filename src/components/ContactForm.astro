---
import { site } from '../data/site';

const TOPICS = [
  'A question about a guide',
  'A topic to cover',
  'A correction',
  'Working together',
  'An earlier PDF purchase',
  'Something else',
];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const sent = Astro.url.searchParams.get('sent') === '1';
---

<form method="post" action="/api/contact" class="contact-form" data-contact-form>
  <input type="hidden" name="redirect" value="/contact?sent=1" />
  <label class="honeypot" aria-hidden="true">
    Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <div class="row">
    <label class="field">
      Name
      <input class="input" type="text" name="name" autocomplete="name" placeholder="First and last name" required />
    </label>
    <label class="field">
      Email
      <input class="input" type="email" name="email" autocomplete="email" placeholder="you@yourcompany.com" required />
    </label>
  </div>

  <fieldset class="topics">
    <legend>What is it about?</legend>
    <div class="topic-chips">
      {
        TOPICS.map((t) => (
          <label class="topic-chip">
            <input type="checkbox" name="topic" value={t} />
            <span>{t}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label class="field">
    Tell me briefly
    <span class="hint">
      If it is about a specific article, the link or title is enough — I can find the rest.
    </span>
    <textarea class="input" name="message" rows="5" required></textarea>
  </label>

  {
    turnstileKey && (
      <Fragment>
        <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto" />
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
      </Fragment>
    )
  }

  <button type="submit" class="btn btn-accent btn-block" data-submit>
    {sent ? 'Sent ✓' : 'Send message'}
  </button>
  <p class="notice-ok" role="status" data-done hidden={!sent}>
    Thank you. I have your message and will reply within one working day.
  </p>
  <p class="notice-error" role="alert" data-error hidden></p>
  <p class="alt">Or just email me at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-form :global(.btn) {
    align-self: flex-start;
    width: auto;
    min-width: 200px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .topics {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  legend {
    padding: 0;
    margin-bottom: 4px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topic-chip {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }
  .topic-chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .topic-chip span {
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--border-input);
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .topic-chip:hover span {
    border-color: var(--ink);
  }
  .topic-chip input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .topic-chip input:focus-visible + span {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .alt {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .alt a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
      const done = form.querySelector<HTMLElement>('[data-done]');
      const err = form.querySelector<HTMLElement>('[data-error]');
      if (btn) {
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = 'Sending…';
      }
      if (err) err.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');
        if (done) done.hidden = false;
        if (btn) btn.textContent = 'Sent ✓';
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]), textarea').forEach((el) => {
          if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = false;
          else el.value = '';
        });
      } catch (ex) {
        if (err) {
          err.textContent = ex instanceof Error ? ex.message : 'Something went wrong.';
          err.hidden = false;
        }
        if (btn) btn.textContent = 'Send message';
        // Reset Turnstile so the visitor can retry.
        const w = window as unknown as { turnstile?: { reset: () => void } };
        w.turnstile?.reset();
      } finally {
        if (btn) btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
