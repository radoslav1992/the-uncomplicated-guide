---
/**
 * One article in a grid, after the theme's blog card: a rounded image (or a generated
 * cover when the article has none), the title, a short description and a meta line.
 */
import Cover from "./Cover.astro";
import { formatDate } from "../lib/http";
import { postCategory, postUrl, readingTime, type Post } from "../lib/blog";

interface Props {
  post: Post;
  /** Position in its grid; staggers the reveal animation. */
  index?: number;
  /** Heading level for the title, so cards sit correctly in each page's outline. */
  headingLevel?: 2 | 3;
}

const { post, index = 0, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const url = postUrl(post);
const category = postCategory(post);
---

<article class="post-card" data-reveal style={`--i: ${index % 3}`}>
  <a href={url} class="thumb" tabindex="-1" aria-hidden="true">
    {post.data.image ? (
      <img
        src={post.data.image}
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Cover post={post} />
    )}
  </a>
  <div class="content">
    <Heading class="title">
      <a href={url}>{post.data.title}</a>
    </Heading>
    <p class="desc">{post.data.description}</p>
    <p class="meta">
      <span class="category">{category.name}</span>
      <span aria-hidden="true">—</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </p>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .post-card:hover .thumb img {
    transform: scale(1.06);
  }
  .post-card:hover .thumb :global(.cover-shape) {
    transform: rotate(18deg) scale(1.08);
  }
  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 22px;
  }
  .title {
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.08;
    letter-spacing: -0.045em;
    max-width: 22ch;
  }
  .title a:hover {
    color: var(--text-2);
  }
  .desc {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .category {
    font-weight: 500;
    color: var(--ink);
  }
</style>
