---
/**
 * One article in a grid: image (when the article has one), category, title,
 * description, date and reading time. The whole card is one link target.
 */
import { formatDate } from "../lib/http";
import { postCategory, postUrl, readingTime, type Post } from "../lib/blog";

interface Props {
  post: Post;
  /** Kept for callers that pass a position; cards no longer show it. */
  index?: number;
  /** Heading level for the title, so cards sit correctly in each page's outline. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const url = postUrl(post);
const category = postCategory(post);
---

<article class:list={["article-card", { "has-image": post.data.image }]}>
  {post.data.image && (
    <div class="card-media">
      <img
        src={post.data.image}
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="card-body">
    <p class="card-category">{category.name}</p>
    <Heading class="card-title">
      <a href={url}>{post.data.title}</a>
    </Heading>
    <p class="card-desc">{post.data.description}</p>
    <p class="card-meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </p>
  </div>
</article>

<style>
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .article-card:hover {
    border-color: var(--border-2);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .article-card:focus-within {
    border-color: var(--accent-text);
  }
  .card-media {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .card-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }
  .card-category {
    margin: 0;
    font-size: 13px;
    font-weight: 650;
    color: var(--accent-text);
  }
  .card-title {
    margin: 8px 0 0;
    font-size: clamp(18.5px, 1.5vw, 21px);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .card-title a {
    color: var(--ink);
  }
  /* Stretch the title link over the whole card. */
  .card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card-title a:focus-visible {
    outline: none;
  }
  .card-desc {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding-top: 16px;
    font-size: 13.5px;
    color: var(--muted);
  }
</style>
