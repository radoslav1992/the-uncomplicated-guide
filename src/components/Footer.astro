---
import { site } from "../data/site";
import { availableGuides } from "../data/guides";
import SignupForm from "./SignupForm.astro";

const year = new Date().getFullYear();
const nav = [
  { label: "Library", href: "/guides" },
  ...availableGuides.map((g) => ({
    label: g.title,
    href: `/guides/${g.slug}`,
  })),
  { label: "Blog", href: "/blog" },
  { label: "Your guides", href: "/account" },
  { label: "About", href: "/#author" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <p>
      Your next chapter
      <br />
      <em>starts here.</em>
    </p>
    <a href="/guides">Find yours in the library ↗</a>
  </div>
  <div class="container cols">
    <div class="col">
      <p class="brand">
        <img src="/brand/next-chapter.webp" alt="" width="28" height="28" />
        <span>{site.name}</span>
      </p>
      <p class="muted">{site.legalName}</p>
      <p class="muted">{site.reach}</p>
      <div class="newsletter">
        <p class="heading">Newsletter</p>
        <p class="muted">{site.newsletterBlurb}</p>
        <SignupForm compact source="footer" />
      </div>
    </div>
    <div class="col">
      <p class="heading">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav class="col" aria-label="Footer navigation">
      <p class="heading">Navigation</p>
      {nav.map((it) => (
        <a href={it.href}>{it.label}</a>
      ))}
    </nav>
    <div class="col">
      <p class="heading">Terms</p>
      {site.legalNav.map((it) => (
        <a href={it.href}>{it.label}</a>
      ))}
      <p class="muted">{site.footerPromise}</p>
    </div>
  </div>
  <div class="container bottom">
    <p class="muted">
      © {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    padding-top: 50px;
    padding-bottom: 30px;
    border-bottom: 1px solid #ffffff24;
  }
  .footer-top p {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(38px, 5vw, 70px);
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .footer-top em {
    font-family: var(--font-editorial);
    font-weight: 300;
    font-style: normal;
    color: #fb7515;
  }
  .footer-top a {
    font-size: 13px;
    color: #fb7515;
  }
  .site-footer :global(.btn-accent) {
    background: #fb7515;
    color: #111111;
  }
  .site-footer :global(.btn-accent:hover) {
    background: #ff974c;
    color: #111111;
  }
  .site-footer :global(.notice) {
    color: #91dda0;
  }
  .site-footer :global(.notice-error) {
    color: #ffd4ca;
  }
  .site-footer :global(.fields) {
    grid-template-columns: 1fr;
  }
  .site-footer :global(.input) {
    min-width: 0;
  }
  .col {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .footer-top {
      align-items: start;
      flex-direction: column;
    }
    .footer-top p {
      font-size: 27px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: #111111;
    --ink: #f5f5f1;
    --text: #d0d9dc;
    --text-2: #d0d9dc;
    --text-3: #d0d9dc;
    --muted: #b1bfc2;
    --border: #ffffff24;
    --border-input: #64747c;
    --bg-input: #1b1b1b;
    --accent: #fb7515;
    --accent-link-hover: #ffffff;
    color: #f5f5f1;
    margin-top: auto;
  }
  .cols {
    padding-top: 48px;
    padding-bottom: 28px;
    display: grid;
    grid-template-columns: 1.6fr 1.2fr 0.85fr 1fr;
    gap: 32px;
  }
  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
    font-size: 14px;
  }
  .col a {
    color: var(--text-2);
    transition: color 0.16s ease;
  }
  .col a:hover {
    color: var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }
  .brand img {
    width: 28px;
    height: 28px;
    flex: none;
    display: block;
  }
  .heading {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    margin: 0 0 4px;
  }
  .muted {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }
  .newsletter {
    margin-top: 14px;
    width: 100%;
    max-width: 340px;
    display: grid;
    gap: 8px;
  }
  .newsletter .heading {
    margin-top: 6px;
  }
  .bottom {
    padding-top: 18px;
    padding-bottom: 18px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
