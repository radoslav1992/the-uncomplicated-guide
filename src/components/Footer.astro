---
/**
 * Site footer, after the Adon template's footer: a large call to action on the left
 * (here: the newsletter), link columns on the right, and a copyright line.
 */
import { site } from "../data/site";
import { categoriesWithPosts, getPosts } from "../lib/blog";
import SignupForm from "./SignupForm.astro";

interface Props {
  /** Recorded with signups made here; defaults to the page path. */
  source?: string;
  /** Optional interest tag recorded with the signup. */
  topic?: string;
  /** Leave the form out on pages that already are a signup page. */
  hideSignup?: boolean;
}

const { source, topic, hideSignup = false } = Astro.props;
const year = new Date().getFullYear();
const categories = categoriesWithPosts(await getPosts());
const nav = [
  { label: "All articles", href: "/blog" },
  { label: "Newsletter", href: "/newsletter" },
  { label: "About", href: "/#author" },
  { label: "Contact", href: "/contact" },
  { label: "RSS feed", href: "/rss.xml" },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-cta">
        <h2>
          Get the next <em>article</em> in your inbox
        </h2>
        {hideSignup ? (
          <a href="/blog" class="arrow-link">Read the articles</a>
        ) : (
          <div class="footer-form">
            <SignupForm compact source={source} topic={topic} buttonLabel="Subscribe" />
            <p class="small">{site.newsletterBlurb}</p>
          </div>
        )}
      </div>
      <div class="footer-links">
        <nav aria-label="Categories">
          <p class="heading">Categories</p>
          <ul>
            {categories.map((category) => (
              <li><a href={category.url}>{category.name}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Footer navigation">
          <p class="heading">Read</p>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Legal">
          <p class="heading">Legal</p>
          <ul>
            {site.legalNav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {year} <span>{site.name}</span> · {site.legalTraderName}, {site.author.city}
      </p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }
  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    border-top: 1px solid var(--border);
  }
  .footer-cta {
    padding: clamp(40px, 6vw, 84px) clamp(0px, 4vw, 56px) clamp(40px, 6vw, 84px) 0;
    border-right: 1px solid var(--border);
  }
  .footer-cta h2 {
    max-width: 11ch;
    font-size: clamp(38px, 5.2vw, 72px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .footer-form {
    max-width: 440px;
    margin-top: clamp(24px, 3vw, 40px);
    display: grid;
    gap: 10px;
  }
  .footer-cta > .arrow-link {
    margin-top: 28px;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-content: start;
    padding: clamp(40px, 6vw, 84px) 0 clamp(40px, 6vw, 84px) clamp(24px, 4vw, 56px);
  }
  .heading {
    margin: 0 0 16px;
    font-size: 15px;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  li a {
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  li a:hover {
    color: var(--accent-text);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 22px 0 28px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    color: var(--muted);
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-bottom span,
  .footer-bottom a {
    color: var(--ink);
  }
  .footer-bottom a:hover {
    color: var(--accent-text);
  }
  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
    }
    .footer-cta {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .footer-links {
      padding-left: 0;
    }
  }
  @media (max-width: 520px) {
    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
