---
import { site } from "../data/site";
import { categoriesWithPosts, getPosts } from "../lib/blog";
import SignupForm from "./SignupForm.astro";

const year = new Date().getFullYear();
const categories = categoriesWithPosts(await getPosts());
const nav = [
  { label: "Newsletter", href: "/newsletter" },
  { label: "About", href: "/#author" },
  { label: "Contact", href: "/contact" },
  { label: "RSS feed", href: "/rss.xml" },
];
---

<footer class="site-footer">
  <div class="container cols">
    <div class="col about">
      <p class="brand">
        <img src="/brand/next-chapter.webp" alt="" width="32" height="32" />
        <span>{site.name}</span>
      </p>
      <p class="muted">{site.tagline}.</p>
      <div class="newsletter">
        <p class="heading">Newsletter</p>
        <p class="muted">{site.newsletterBlurb}</p>
        <SignupForm compact source="footer" />
      </div>
    </div>
    <nav class="col" aria-label="Categories">
      <p class="heading">Categories</p>
      {categories.map((category) => (
        <a href={category.url}>{category.name}</a>
      ))}
      <a href="/blog">All articles</a>
    </nav>
    <nav class="col" aria-label="Footer navigation">
      <p class="heading">Read more</p>
      {nav.map((it) => (
        <a href={it.href}>{it.label}</a>
      ))}
    </nav>
    <div class="col">
      <p class="heading">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p class="heading legal-heading">Legal</p>
      {site.legalNav.map((it) => (
        <a href={it.href}>{it.label}</a>
      ))}
    </div>
  </div>
  <div class="container bottom">
    <p class="muted">
      © {year} {site.legalName} · {site.author.city}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.1fr;
    gap: 32px;
    padding-top: 48px;
    padding-bottom: 32px;
  }
  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .col a {
    color: var(--text-2);
  }
  .col a:hover {
    color: var(--accent-text);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand img {
    width: 32px;
    height: 32px;
    flex: none;
  }
  .heading {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }
  .legal-heading {
    margin-top: 14px;
  }
  .muted {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .newsletter {
    width: 100%;
    max-width: 380px;
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }
  .bottom {
    padding-top: 18px;
    padding-bottom: 24px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
