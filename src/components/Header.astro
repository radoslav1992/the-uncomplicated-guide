---
import { site } from '../data/site';
interface Props { current?: string; }
const { current = '' } = Astro.props;
---
<header class="site-header"><div class="container inner">
  <a href="/" class="brand" aria-label={`${site.name} — home`}><img src="/brand/logo-mark.png" alt="" width="34" height="34" /><span>{site.shortName}<small>guides</small></span></a>
  <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
  <nav id="main-navigation" aria-label="Main navigation">{site.nav.map(item=><a href={item.href} class:list={['nav-link',{current:item.label===current}]} aria-current={item.label===current?'page':undefined}>{item.label}</a>)}<a href="/account" class="account">My guides ↗</a></nav>
</div></header>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav = document.querySelector<HTMLElement>('#main-navigation');
if(toggle && nav){
 document.documentElement.classList.add('nav-ready');
 const close=()=>{toggle.setAttribute('aria-expanded','false');nav.classList.remove('open');};
 toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav.classList.toggle('open',open);});
 nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
 document.addEventListener('click',e=>{if(e.target instanceof Node&&!nav.contains(e.target)&&!toggle.contains(e.target))close();});
}
</script>
<style>
.site-header{position:sticky;top:0;z-index:50;background:#f6f3eef5;border-bottom:1px solid var(--border);backdrop-filter:blur(12px)}.inner{display:flex;align-items:center;gap:28px;min-height:78px}.brand{display:flex;align-items:center;gap:10px;color:var(--ink);margin-right:auto}.brand>span{font-family:var(--font-display);font-weight:600;font-size:17px;letter-spacing:-.02em}.brand small{font-family:var(--font-body);font-weight:400;font-size:12px;color:var(--muted);margin-left:6px}nav{display:flex;align-items:center;gap:25px;font-size:14px}.nav-link{color:var(--text);padding:12px 0}.nav-link.current{text-decoration:underline;text-underline-offset:6px;color:var(--ink)}.account{border:1px solid var(--border-2);border-radius:999px;color:var(--ink);font-weight:600;padding:11px 17px}.account:hover{border-color:var(--ink)}.menu-toggle{display:none}@media(max-width:850px){.inner{flex-wrap:wrap;gap:0;min-height:70px;padding-top:12px;padding-bottom:12px}.brand>span{font-size:15px}.brand small{display:none}.brand img{width:30px;height:30px}nav{width:100%;display:flex;flex-direction:column;align-items:stretch;gap:0;padding-top:14px}.nav-link{padding:13px 4px}.account{margin:8px 0;align-self:start}:global(.nav-ready) nav:not(.open){display:none}:global(.nav-ready) .menu-toggle{display:flex;align-items:center;gap:10px;border:1px solid var(--border-2);background:var(--bg);color:var(--ink);border-radius:8px;padding:10px 12px;min-height:44px;font:inherit;font-size:14px;cursor:pointer}}
</style>
