---
import { site } from "../data/site";
interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src="/brand/next-chapter.webp" alt="" width="42" height="42" />
      <span>
        {site.shortName}
        <small>GUIDES FOR WHAT COMES NEXT</small>
      </span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-controls="main-navigation"
      aria-expanded="false"
    >
      Menu <span aria-hidden="true">☰</span>
    </button>
    <nav id="main-navigation" aria-label="Main navigation">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { current: item.label === current }]}
          aria-current={item.label === current ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/account" class="account">
        My guides ↗
      </a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#main-navigation");
  if (toggle && nav) {
    document.documentElement.classList.add("nav-ready");
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      nav.classList.remove("open");
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("open", open);
    });
    nav
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (
        e.target instanceof Node &&
        !nav.contains(e.target) &&
        !toggle.contains(e.target)
      )
        close();
    });
  }
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #111111f2;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 88px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    margin-right: auto;
  }
  .brand > span {
    font-family: var(--font-body);
    font-weight: 650;
    font-size: 20px;
    letter-spacing: -0.055em;
    line-height: 1.2;
  }
  .brand small {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 7px;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-top: 5px;
  }
  .brand img {
    width: 42px;
    height: 42px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 25px;
    font-size: 12px;
  }
  .nav-link {
    color: var(--text);
    padding: 14px 0;
    position: relative;
  }
  .nav-link::after {
    content: "";
    height: 2px;
    position: absolute;
    bottom: 5px;
    left: 0;
    right: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s;
  }
  .nav-link:hover::after,
  .nav-link.current::after {
    transform: scaleX(1);
  }
  .nav-link.current {
    color: var(--ink);
  }
  .account {
    border: 1px solid var(--accent);
    background: var(--accent);
    border-radius: 0;
    color: #111;
    font-weight: 600;
    padding: 12px 16px;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .account:hover {
    border-color: var(--ink);
    background: #292929;
    color: var(--ink);
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 850px) {
    .inner {
      flex-wrap: wrap;
      gap: 0;
      min-height: 76px;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .brand > span {
      font-size: 18px;
    }
    .brand small {
      font-size: 6px;
    }
    .brand img {
      width: 36px;
      height: 36px;
    }
    nav {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 14px;
      font-size: 14px;
    }
    .nav-link {
      padding: 13px 4px;
    }
    .nav-link::after {
      right: auto;
      width: 28px;
    }
    .account {
      margin: 8px 0;
      align-self: start;
    }
    :global(.nav-ready) nav:not(.open) {
      display: none;
    }
    :global(.nav-ready) .menu-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--border-2);
      background: var(--bg);
      color: var(--ink);
      border-radius: 0;
      padding: 10px 12px;
      min-height: 44px;
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
  }
  @media (max-width: 420px) {
    .brand > span {
      font-size: 16px;
    }
    .brand small {
      font-size: 5.5px;
    }
    .brand {
      gap: 8px;
    }
  }
</style>
