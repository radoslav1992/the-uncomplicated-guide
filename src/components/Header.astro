---
import { site } from "../data/site";
interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src="/brand/next-chapter.webp" alt="" width="36" height="36" />
      <span>{site.name}</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-controls="main-navigation"
      aria-expanded="false"
    >
      Menu <span aria-hidden="true">☰</span>
    </button>
    <nav id="main-navigation" aria-label="Main navigation">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { current: item.label === current }]}
          aria-current={item.label === current ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/newsletter" class="btn btn-accent subscribe">
        Subscribe
      </a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#main-navigation");
  if (toggle && nav) {
    document.documentElement.classList.add("nav-ready");
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      nav.classList.remove("open");
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("open", open);
    });
    nav
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (
        e.target instanceof Node &&
        !nav.contains(e.target) &&
        !toggle.contains(e.target)
      )
        close();
    });
  }
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(1.4) blur(12px);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: var(--header-h);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--ink);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand img {
    width: 36px;
    height: 36px;
    flex: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-link {
    color: var(--text-2);
    font-size: 15.5px;
    font-weight: 550;
    padding: 8px 12px;
    border-radius: 8px;
    transition:
      color 0.16s ease,
      background-color 0.16s ease;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }
  .nav-link.current {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  .subscribe {
    margin-left: 10px;
    min-height: 40px;
    padding: 9px 16px;
    font-size: 14.5px;
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 820px) {
    .inner {
      flex-wrap: wrap;
      gap: 0;
      padding-top: 12px;
      padding-bottom: 12px;
      min-height: 0;
    }
    .brand {
      font-size: 16px;
    }
    .brand img {
      width: 32px;
      height: 32px;
    }
    nav {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding-top: 12px;
    }
    .nav-link {
      font-size: 16px;
      padding: 12px 8px;
    }
    .nav-link.current {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-left: 14px;
    }
    .subscribe {
      margin: 10px 0 6px;
      align-self: start;
    }
    :global(.nav-ready) nav:not(.open) {
      display: none;
    }
    :global(.nav-ready) .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border-2);
      background: var(--card);
      color: var(--ink);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      min-height: 42px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
  }
</style>
