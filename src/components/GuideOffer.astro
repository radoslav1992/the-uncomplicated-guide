---
/**
 * The free PDF for subscribers (`site.freeGuide`), offered at the end of articles on the
 * same subject. Signing up here is an ordinary newsletter signup; the download link is
 * emailed once the address is confirmed.
 */
import { site } from "../data/site";
import SignupForm from "./SignupForm.astro";

interface Props {
  /** Recorded with signups made here. */
  source?: string;
  topic?: string;
}

const { source = "guide-offer", topic } = Astro.props;
const guide = site.freeGuide;
---

<aside class="guide-offer" aria-labelledby="guide-offer-title">
  <img src={guide.cover} alt="" width="720" height="1018" loading="lazy" decoding="async" />
  <div class="copy">
    <span class="pill">Free PDF</span>
    <p class="title" id="guide-offer-title">Take the whole guide with you</p>
    <p class="text">
      <strong>{guide.title}</strong> — the {guide.pages}-page guide this article grew out of — is
      free when you join the newsletter. The download link is emailed as soon as you confirm your
      address.
    </p>
    <SignupForm compact source={source} topic={topic} buttonLabel="Send me the PDF" />
    <p class="small">After that, one email when a new article is published. Unsubscribe with one click.</p>
  </div>
</aside>

<style>
  .guide-offer {
    display: grid;
    grid-template-columns: clamp(110px, 18%, 170px) minmax(0, 1fr);
    gap: clamp(22px, 3.4vw, 44px);
    align-items: center;
    margin-top: clamp(40px, 5vw, 64px);
    padding: clamp(22px, 3vw, 38px);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 5px;
    box-shadow: 0 22px 40px -22px rgba(17, 17, 17, 0.6), 0 1px 4px rgba(17, 17, 17, 0.12);
    transform: rotate(-3deg);
  }
  .copy {
    display: grid;
    justify-items: start;
    gap: 12px;
  }
  .copy :global(form) {
    width: 100%;
    max-width: 480px;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--ink);
  }
  .text {
    max-width: 58ch;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .text strong {
    color: var(--ink);
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .guide-offer {
      grid-template-columns: 1fr;
    }
    img {
      width: 120px;
    }
  }
</style>
