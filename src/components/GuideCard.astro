---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { Guide } from "../data/guides";
import { formatPrice } from "../data/site";
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const isVoice = guide.slug === "ai-assistants";
---

<article class:list={["guide-card", { voice: isVoice }]}>
  <a
    class="art"
    href={`/guides/${guide.slug}`}
    aria-label={`Explore ${guide.title}`}
  >
    <span class="category">
      {isVoice ? "Voice AI & automation" : "Video & content"}
    </span>
    <span class="art-ring" aria-hidden="true"></span>
    <span class="book-object">
      {guide.cover ? (
        <Image
          src={guide.cover}
          alt={`${guide.title} cover`}
          widths={[240, 480]}
          sizes="(max-width: 640px) 170px, 200px"
          loading="lazy"
        />
      ) : (
        <span class="placeholder">{guide.title}</span>
      )}
    </span>
    <span class="format">PDF / English</span>
    <span class="art-arrow">
      <Icon name="arrow" size={20} />
    </span>
  </a>
  <div class="body">
    <div class="facts">
      <span>
        {guide.pages ? `${guide.pages} pages` : "Practical playbook"} · Instant
        download
      </span>
      <strong>
        {formatPrice(guide.price, guide.currency)}{" "}
        <small>{guide.currency}</small>
      </strong>
    </div>
    <h3>
      <a href={`/guides/${guide.slug}`}>{guide.title}</a>
    </h3>
    <p>{guide.short}</p>
    <div class="actions">
      <a href={`/guides/${guide.slug}`} class="btn btn-dark">
        Explore the guide <Icon name="arrow" size={18} />
      </a>
      <a
        href={`/guides/${guide.slug}#sample`}
        class="sample-link"
        data-track="view_sample"
        data-guide={guide.slug}
      >
        Read a free sample
      </a>
    </div>
  </div>
</article>
<style>
  .guide-card {
    border: 1px solid var(--border);
    border-radius: 0;
    overflow: hidden;
    background: var(--card);
    display: flex;
    flex-direction: column;
    transition:
      box-shadow 0.3s,
      border-color 0.3s;
    min-width: 0;
  }
  .guide-card:hover {
    border-color: var(--accent);
    box-shadow: 0 18px 40px #2335420c;
  }
  .art {
    min-height: 365px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: #25201c;
    padding: 50px 30px 36px;
    color: var(--ink);
  }
  .voice .art {
    background: #1b2326;
  }
  .art-ring {
    position: absolute;
    width: 270px;
    aspect-ratio: 1;
    border: 1px solid #fb751550;
    border-radius: 50%;
    transform: translate(75px, 30px);
  }
  .art-ring::after {
    content: "";
    position: absolute;
    inset: -25px;
    border: 1px solid #fb751525;
    border-radius: 50%;
  }
  .voice .art-ring {
    border-color: #ffffff30;
  }
  .voice .art-ring::after {
    border-color: #ffffff18;
  }
  .category {
    position: absolute;
    top: 22px;
    left: 24px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    z-index: 1;
  }
  .book-object {
    position: relative;
    display: block;
    width: 200px;
    transform: perspective(900px) rotateY(-12deg) rotateZ(-5deg);
    box-shadow: 10px 19px 24px #172c372b;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book-object::before {
    content: "";
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 100%;
    width: 9px;
    background: repeating-linear-gradient(
      90deg,
      #f9f4e9 0 2px,
      #d9d1c2 2px 3px
    );
    transform: skewY(25deg);
    transform-origin: left;
  }
  .book-object::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #0f202c40,
      transparent 4%,
      #ffffff20 5%,
      transparent 9%
    );
    pointer-events: none;
  }
  .art img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .art:hover .book-object,
  .art:focus-visible .book-object {
    transform: perspective(900px) rotateY(-3deg) rotateZ(0deg) translateY(-9px);
  }
  .format {
    position: absolute;
    left: 24px;
    bottom: 20px;
    font-size: 11px;
    color: var(--text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .art-arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid #ffffff40;
    border-radius: 50%;
    position: absolute;
    right: 24px;
    bottom: 18px;
    transition:
      background 0.2s,
      transform 0.3s;
  }
  .art:hover .art-arrow {
    background: #ffffff15;
    transform: rotate(-35deg);
  }
  .body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .facts {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    color: var(--text);
  }
  .facts strong {
    font-size: 32px;
    color: var(--ink);
    white-space: nowrap;
    letter-spacing: -0.04em;
  }
  .facts small {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(23px, 2.3vw, 29px);
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin: 15px 0 12px;
  }
  h3 a {
    color: var(--ink);
  }
  p {
    color: var(--text);
    font-size: 15px;
    line-height: 1.75;
    margin: 0 0 26px;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: auto;
  }
  .actions .btn {
    font-size: 14px;
    padding: 14px 18px;
  }
  .sample-link {
    text-decoration: underline;
    text-underline-offset: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
  }
  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 2/3;
    background: var(--bg-alt);
    color: white;
    padding: 22px;
  }
  @media (max-width: 640px) {
    .art {
      min-height: 320px;
    }
    .book-object {
      width: 170px;
    }
    .body {
      padding: 22px;
    }
    .facts {
      font-size: 11px;
    }
    .actions {
      gap: 16px;
    }
    .actions .btn {
      padding: 13px 15px;
    }
  }
</style>
