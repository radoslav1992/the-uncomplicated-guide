---
import { Image } from 'astro:assets';
import type { Guide } from '../data/guides';
import { formatPrice } from '../data/site';
interface Props { guide: Guide; }
const { guide } = Astro.props;
---
<article class="guide-card">
  <a class="art" href={`/guides/${guide.slug}`} aria-label={`Explore ${guide.title}`}>
    {guide.cover && <Image src={guide.cover} alt={`${guide.title} cover`} widths={[240,480]} sizes="(max-width: 640px) 180px, 220px" loading="eager" />}
    <span class="format">PDF · English</span>
  </a>
  <div class="body">
    <div class="facts"><span>{guide.pages} pages · {guide.slug === 'ai-assistants' ? 'v1.1' : 'v1.0'}</span><strong>{formatPrice(guide.price,guide.currency)} USD</strong></div>
    <h3><a href={`/guides/${guide.slug}`}>{guide.title}</a></h3>
    <p>{guide.short}</p>
    <div class="actions"><a href={`/guides/${guide.slug}`} class="btn btn-dark">Explore the guide →</a><a href={`/guides/${guide.slug}#sample`} class="sample-link" data-track="view_sample" data-guide={guide.slug}>Read a free sample</a></div>
  </div>
</article>
<style>
.guide-card{border:1px solid var(--border);border-radius:24px;overflow:hidden;background:var(--card);display:flex;flex-direction:column}.art{min-height:320px;display:flex;align-items:center;justify-content:center;position:relative;background:radial-gradient(ellipse at center,#e5d8c6,transparent 75%),var(--bg-alt);padding:32px}.art img{width:200px;height:auto;transform:rotate(-3deg);box-shadow:10px 16px 25px #16130f2b;transition:transform .2s}.art:hover img{transform:rotate(0deg) translateY(-4px)}.format{position:absolute;right:18px;bottom:16px;font-size:12px;color:var(--text)}.body{padding:28px;display:flex;flex-direction:column;flex:1}.facts{display:flex;justify-content:space-between;gap:16px;font-size:14px;color:var(--text)}.facts strong{color:var(--accent);white-space:nowrap}h3{font-family:var(--font-display);font-size:clamp(20px,2.3vw,26px);line-height:1.3;letter-spacing:-.025em;margin:18px 0 12px}h3 a{color:var(--ink)}p{color:var(--text);font-size:16px;line-height:1.6;margin:0 0 26px}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-top:auto}.sample-link{text-decoration:underline;text-underline-offset:4px;font-size:14px;font-weight:600}@media(max-width:640px){.art{min-height:285px}.art img{width:165px}.body{padding:23px}.actions{align-items:flex-start;flex-direction:column}}
</style>
