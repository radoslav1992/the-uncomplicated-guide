---
/**
 * A long-form guide, presented large: image, chapter count, reading time and
 * the chapter titles, so the reader sees what is inside before clicking.
 */
import { postUrl, readingTime, type Post } from "../lib/blog";

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const url = postUrl(post);
// Chapters are the article's `## ` headings, read from the Markdown source.
const chapters = (post.body ?? "")
  .split("\n")
  .filter((line) => /^## /.test(line))
  .map((line) => line.replace(/^## /, "").replace(/[*_`]/g, "").trim());
const shown = chapters.slice(0, 6);
---

<article class="guide-feature" data-reveal>
  <a href={url} class="feature-media" tabindex="-1" aria-hidden="true">
    {post.data.image && (
      <img
        src={post.data.image}
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    )}
    <span class="feature-badge">Free guide</span>
  </a>
  <div class="feature-body">
    <div class="feature-meta">
      <span>{chapters.length} chapters</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <Heading class="feature-title">
      <a href={url}>{post.data.title}</a>
    </Heading>
    <p class="feature-desc">{post.data.description}</p>
    {shown.length > 0 && (
      <ol class="feature-chapters" aria-label="Chapters">
        {shown.map((chapter) => (
          <li>{chapter}</li>
        ))}
        {chapters.length > shown.length && (
          <li class="more">+ {chapters.length - shown.length} more</li>
        )}
      </ol>
    )}
    <a href={url} class="rr-btn-classic feature-cta">
      Read the guide <span class="button-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .guide-feature {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border);
  }
  .feature-media {
    position: relative;
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-alt);
  }
  .feature-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .guide-feature:hover .feature-media img {
    transform: scale(1.03);
  }
  .feature-badge {
    position: absolute;
    left: 18px;
    top: 18px;
    background: var(--accent);
    color: #111;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 7px 10px;
  }
  .feature-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 24px 26px;
  }
  .feature-meta {
    display: flex;
    gap: 18px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .feature-title {
    font: 300 clamp(26px, 2.7vw, 38px) / 1.08 var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    margin: 14px 0 0;
    text-wrap: balance;
  }
  .feature-title a {
    color: var(--ink);
  }
  .feature-title a:hover {
    color: var(--accent);
  }
  .feature-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text);
    margin: 16px 0 0;
  }
  .feature-chapters {
    list-style: none;
    counter-reset: chapter;
    margin: 22px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .feature-chapters li {
    counter-increment: chapter;
    display: flex;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--text-3);
  }
  .feature-chapters li::before {
    content: counter(chapter, decimal-leading-zero);
    flex: none;
    width: 22px;
    color: var(--accent);
    font-size: 11px;
    padding-top: 2px;
  }
  .feature-chapters li.more {
    color: var(--muted);
  }
  .feature-chapters li.more::before {
    content: "";
  }
  .feature-cta {
    margin-top: 26px;
  }
  @media (min-width: 721px) {
    .feature-cta {
      margin-top: auto;
    }
    .feature-chapters {
      margin-bottom: 26px;
    }
  }
</style>
