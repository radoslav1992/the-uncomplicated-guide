---
/**
 * A featured article, presented large: wide rounded image, big title, description,
 * and how long the read is.
 */
import Cover from "./Cover.astro";
import { chapters, postCategory, postUrl, readingTime, type Post } from "../lib/blog";

interface Props {
  post: Post;
  index?: number;
  headingLevel?: 2 | 3;
}

const { post, index = 0, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const url = postUrl(post);
const category = postCategory(post);
const sections = chapters(post).length;
---

<article class="featured" data-reveal style={`--i: ${index}`}>
  <a href={url} class="thumb" tabindex="-1" aria-hidden="true">
    {post.data.image ? (
      <img
        src={post.data.image}
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Cover post={post} />
    )}
    <span class="chip badge">{category.name}</span>
  </a>
  <div class="content">
    <Heading class="title">
      <a href={url}>{post.data.title}</a>
    </Heading>
    <p class="desc">{post.data.description}</p>
    <div class="foot">
      <p class="meta">
        <span>{readingTime(post.body)} min read</span>
        {sections > 0 && (
          <Fragment>
            <span aria-hidden="true">·</span>
            <span>{sections} sections</span>
          </Fragment>
        )}
      </p>
      <a href={url} class="arrow-link" aria-label={`Read ${post.data.title}`}>
        Read the article
      </a>
    </div>
  </div>
</article>

<style>
  .featured {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .featured:hover .thumb img {
    transform: scale(1.05);
  }
  .badge {
    position: absolute;
    left: 18px;
    top: 18px;
    background: #ffffff;
    color: #111111;
  }
  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 26px;
  }
  .title {
    font-size: clamp(27px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.05em;
  }
  .title a:hover {
    color: var(--text-2);
  }
  .desc {
    margin-top: 16px;
    max-width: 56ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: auto;
    padding-top: 22px;
  }
  .meta {
    display: flex;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
</style>
