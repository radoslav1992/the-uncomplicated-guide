---
/**
 * Newsletter signup (double opt-in). Posts to /api/newsletter/subscribe; works without JS via redirect.
 */
interface Props {
  /** Optional guide slug to record what the person is interested in. */
  guide?: string;
  redirect?: string;
  buttonLabel?: string;
  source?: string;
  /** Single-line layout for the footer. */
  compact?: boolean;
}
const {
  guide,
  redirect = '/newsletter?status=check',
  buttonLabel = 'Subscribe',
  source = Astro.url.pathname,
  compact = false,
} = Astro.props;
---

<form method="post" action="/api/newsletter/subscribe" class:list={['signup', { compact }]} data-signup-form>
  <input type="hidden" name="redirect" value={redirect} />
  <input type="hidden" name="source" value={source} />
  {guide && <input type="hidden" name="guide" value={guide} />}
  <label class="honeypot" aria-hidden="true">
    Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>
  <div class="fields" data-fields>
    <label class="field">
      <span class:list={['label', { 'visually-hidden': compact }]}>Email</span>
      <input class="input" type="email" name="email" required autocomplete="email" placeholder="you@yourcompany.com" />
    </label>
    <button type="submit" class="btn btn-accent">{buttonLabel}</button>
  </div>
  <p class="notice" data-done hidden role="status">
    One more click: a confirmation email is on its way. Nothing is sent until you open it.
  </p>
  <p class="notice-error" data-error hidden role="alert"></p>
</form>

<style>
  .signup,
  .fields {
    display: grid;
    gap: 14px;
  }
  .label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-3);
  }
  .input {
    font-size: 16px;
  }
  .btn {
    justify-self: start;
  }
  .compact .fields {
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }
  .compact .input {
    font-size: 14.5px;
    padding: 11px 13px;
  }
  .compact .btn {
    padding: 12px 18px;
    font-size: 14.5px;
  }
  .compact .notice,
  .compact .notice-error {
    font-size: 13.5px;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-signup-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const fields = form.querySelector<HTMLElement>('[data-fields]');
      const done = form.querySelector<HTMLElement>('[data-done]');
      const err = form.querySelector<HTMLElement>('[data-error]');
      if (btn) btn.setAttribute('aria-busy', 'true');
      if (err) err.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json()) as { ok: boolean; error?: string; status?: string };
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');
        if (fields) fields.hidden = true;
        if (done) {
          if (data.status === 'already-confirmed') done.textContent = 'You are already on the list — nothing more to do.';
          done.hidden = false;
        }
      } catch (ex) {
        if (err) {
          err.textContent = ex instanceof Error ? ex.message : 'Something went wrong.';
          err.hidden = false;
        }
      } finally {
        if (btn) btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
