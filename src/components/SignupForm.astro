---
/**
 * Newsletter signup (double opt-in). Posts to /api/newsletter/subscribe; works without JS via redirect.
 */
interface Props {
  /** Optional topic or article slug, recorded with the address as the reader's interest. */
  topic?: string;
  redirect?: string;
  buttonLabel?: string;
  source?: string;
  /** Single-line layout for the footer. */
  compact?: boolean;
}
const {
  topic,
  redirect = '/newsletter?status=check',
  buttonLabel = 'Subscribe',
  source = Astro.url.pathname,
  compact = false,
} = Astro.props;
---

<form method="post" action="/api/newsletter/subscribe" class:list={['signup', { compact }]} data-signup-form>
  <input type="hidden" name="redirect" value={redirect} />
  <input type="hidden" name="source" value={source} />
  {topic && <input type="hidden" name="topic" value={topic} />}
  <label class="honeypot" aria-hidden="true">
    Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>
  <div class="fields" data-fields>
    <label class="field">
      <span class:list={['label', { 'visually-hidden': compact }]}>Email</span>
      <input class="input" type="email" name="email" required autocomplete="email" placeholder="you@yourcompany.com" />
    </label>
    <button type="submit" class="btn btn-accent">{buttonLabel}</button>
  </div>
  <p class="notice" data-done hidden role="status">
    One more click: a confirmation email is on its way. The link to your free PDF follows as soon as you confirm.
  </p>
  <p class="notice-error" data-error hidden role="alert"></p>
</form>

<style>
  .signup,
  .fields {
    display: grid;
    gap: 12px;
  }
  .label {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .btn {
    justify-self: start;
  }
  /* One line: a pill input with the button beside it. */
  .compact .fields {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
  }
  .compact .input {
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 15.5px;
  }
  .compact .notice,
  .compact .notice-error {
    font-size: 14.5px;
  }
  @media (max-width: 420px) {
    .compact .fields {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-signup-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const fields = form.querySelector<HTMLElement>('[data-fields]');
      const done = form.querySelector<HTMLElement>('[data-done]');
      const err = form.querySelector<HTMLElement>('[data-error]');
      if (btn) btn.setAttribute('aria-busy', 'true');
      if (err) err.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json()) as { ok: boolean; error?: string; status?: string; resent?: boolean };
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');
        if (fields) fields.hidden = true;
        if (done) {
          if (data.status === 'already-confirmed')
            done.textContent = data.resent
              ? 'You are already on the list. The link to the PDF has been sent to your inbox again.'
              : 'You are already on the list. The link to the PDF was sent to you earlier today — look for that email.';
          done.hidden = false;
        }
        // A new signup; Base.astro reports it to analytics when the reader has consented.
        if (data.status === 'confirmation-sent')
          document.dispatchEvent(
            new CustomEvent('newsletter:subscribed', {
              detail: { source: new FormData(form).get('source') || location.pathname },
            }),
          );
      } catch (ex) {
        if (err) {
          err.textContent = ex instanceof Error ? ex.message : 'Something went wrong.';
          err.hidden = false;
        }
      } finally {
        if (btn) btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
