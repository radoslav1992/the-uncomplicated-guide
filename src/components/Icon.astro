---
interface Props {
  name: "book" | "arrow" | "check" | "download" | "spark" | "clock";
  size?: number;
}
const { name, size = 24 } = Astro.props;
const paths = {
  book: [
    "M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Z",
    "M12 5v15",
  ],
  arrow: ["M5 12h14", "m13 6 6 6-6 6"],
  check: ["m5 12 4 4L19 6"],
  download: ["M12 3v12", "m7 10 5 5 5-5", "M4 16v5h16v-5"],
  spark: ["m12 2 2.7 7.3L22 12l-7.3 2.7L12 22l-2.7-7.3L2 12l7.3-2.7Z"],
  clock: ["M12 7v5l3 2"],
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "clock" && <circle cx="12" cy="12" r="9" />}
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
