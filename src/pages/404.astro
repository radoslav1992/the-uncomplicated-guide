---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="container wrap">
    <p class="eyebrow">404</p>
    <h1 class="display">That page is not here.</h1>
    <p>The link may be old, or the address mistyped. Everything published is listed under Guides and Articles — all of it free to read.</p>
    <div class="actions">
      <a href="/guides" class="btn btn-accent">Read the free guides</a>
      <a href="/blog" class="btn btn-outline">All articles</a>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-top: 96px;
    padding-bottom: 120px;
    max-width: 720px;
  }
  h1 {
    font-size: clamp(32px, 5.5vw, 52px);
    letter-spacing: -0.04em;
    margin: 12px 0 16px;
  }
  p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
