---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="container wrap">
    <p class="code">404</p>
    <h1 class="title-md">That page <em>is not here</em></h1>
    <p class="text">The link may be old, or the address mistyped. Everything published is listed under Articles — all of it free to read.</p>
    <div class="actions">
      <a href="/blog" class="btn" data-text="All articles"><span>All articles</span></a>
      <a href="/" class="arrow-link">Back to home</a>
    </div>
  </div>
</Base>

<style>
  .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(48px, 8vw, 110px);
    padding-bottom: clamp(72px, 10vw, 140px);
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(120px, 22vw, 300px);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.07em;
    color: var(--ink);
  }
  h1 {
    margin-top: 18px;
  }
  .text {
    max-width: 46ch;
    margin: 18px 0 30px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 24px;
  }
</style>
