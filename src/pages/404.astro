---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="container wrap">
    <p class="eyebrow">404</p>
    <h1 class="display">That page is not here.</h1>
    <p>The link may be old, or the address mistyped. Everything published is listed under Articles — all of it free to read.</p>
    <div class="actions">
      <a href="/blog" class="btn btn-accent">All articles</a>
      <a href="/" class="btn btn-outline">Home</a>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(64px, 10vw, 120px);
    max-width: 720px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 50px);
    line-height: 1.1;
    margin: 10px 0 16px;
  }
  p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
