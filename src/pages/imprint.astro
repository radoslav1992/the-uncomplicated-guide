---
import Legal from '../layouts/Legal.astro';
import { site } from '../data/site';
---

<Legal title="Imprint" description="Publisher and seller details for The Uncomplicated Guides.">
  <h2>Publisher and seller</h2>
  <p>{site.legalTraderName}<br />trading as {site.name}<br />{site.registeredAddress || site.author.city}</p>
  {site.registrationNumber && <p>Company registration: {site.registrationNumber}</p>}
  {site.vatNumber && <p>VAT number: {site.vatNumber}</p>}
  <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>

  <h2>Responsible for content</h2>
  <p>{site.author.name} (author), published and sold by {site.legalTraderName}.</p>

  <h2>Imprint of the guides</h2>
  <p>The guides are published under the <strong>{site.imprint}</strong> imprint. Same author, same text — that is the name in the copyright line inside each file.</p>

  <h2>VAT</h2>
  <p>Prices include VAT where applicable. The seller is responsible for applicable tax reporting and remittance. The final tax treatment appears at checkout. Business buyers needing an invoice with a VAT number should write to the address above after purchase.</p>

  <h2>Dispute resolution</h2>
  <p>The EU Online Dispute Resolution platform closed on 20 July 2025. Please contact us first so we can try to resolve a dispute. Information about consumer redress is available from the <a href="https://consumer-redress.ec.europa.eu/site-relocation_en">European Commission</a>.</p>

  <h2>Copyright</h2>
  <p>All text, covers and templates on this site and in the guides are © {site.legalTraderName}. Use within the licence in the <a href="/terms">terms of sale</a>; anything beyond that requires written permission.</p>
</Legal>
