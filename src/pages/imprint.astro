---
import Legal from '../layouts/Legal.astro';
import { site } from '../data/site';
---

<Legal title="Imprint" description="Publisher details for The Uncomplicated Guides.">
  <h2>Publisher</h2>
  <p>{site.legalTraderName}<br />trading as {site.name}<br />{site.registeredAddress || site.author.city}</p>
  {site.registrationNumber && <p>Company registration: {site.registrationNumber}</p>}
  {site.vatNumber && <p>VAT number: {site.vatNumber}</p>}
  <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>

  <h2>Responsible for content</h2>
  <p>{site.author.name} (author), published by {site.legalTraderName}.</p>

  <h2>Earlier PDF editions</h2>
  <p>Until {site.shopClosed} the guides were also sold as PDF files under the Galactic Guides imprint. Questions about an earlier purchase go to the address above. Information about consumer redress is available from the <a href="https://consumer-redress.ec.europa.eu/site-relocation_en">European Commission</a>.</p>

  <h2>Copyright</h2>
  <p>All text, images and templates on this site are © {site.legalTraderName}. How you may use them is set out in the <a href="/terms">terms of use</a>; anything beyond that requires written permission.</p>
</Legal>
