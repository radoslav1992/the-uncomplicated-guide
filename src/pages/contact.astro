---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<Base
  title="Contact"
  description="A question about a guide, a topic you want covered, or something you think an article got wrong. I read every message and reply within one working day."
  current="Contact"
>
  <div class="container wrap">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="display">Write to me.</h1>
      <p class="intro">
        A question about a guide, a topic you would like covered, a tool that changed since an
        article was written, or something you think I got wrong. I read every message myself
        and reply within one working day.
      </p>
      <ContactForm />
    </div>

    <aside>
      <div class="card reveal">
        <p class="display t">What happens next</p>
        <p>I reply within one working day. Corrections are checked and, where they hold up, the article is updated and dated.</p>
        <p>Bought one of the PDF editions before the guides became free? Write from the address you paid with and I will help.</p>
      </div>
      <div class="card dark reveal" style="--i: 1">
        <p class="display t">Prefer email directly?</p>
        <p class="label">Everything about the guides and articles</p>
        <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
        <p class="fine">Topic suggestions are welcome — the next guides are picked from them.</p>
      </div>
      <div class="card reveal" style="--i: 2">
        <p class="legal-note">
          The Uncomplicated Guides are written by {site.author.name} and published by {site.legalTraderName}, {site.author.city}.<br />
          Legal details are in the <a href="/imprint">imprint</a>.
        </p>
      </div>
    </aside>
  </div>
</Base>

<style>
  .wrap {
    padding-top: clamp(40px, 7vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }
  h1 {
    font-size: clamp(34px, 5vw, 50px);
    line-height: 1.1;
    margin: 10px 0 14px;
  }
  .intro {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 32px;
    max-width: 560px;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 8px;
  }
  .card p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 14px;
  }
  .card p:last-child {
    margin-bottom: 0;
  }
  .card .t {
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .dark {
    background: var(--tint);
  }
  .label {
    font-size: 14px !important;
    font-weight: 600;
    color: var(--ink) !important;
    margin: 0 0 4px !important;
  }
  .mail {
    display: block;
    font-size: 17px;
    font-weight: 600;
    word-break: break-word;
  }
  .fine {
    font-size: 14px !important;
    margin: 10px 0 0 !important;
  }
  .legal-note {
    font-size: 14.5px !important;
  }
  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
    }
    aside {
      padding-top: 0;
    }
  }
</style>
