---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<Base
  title="Contact"
  description="A question about a guide, a topic you want covered, or something you think an article got wrong. I read every message and reply within one working day."
  current="Contact"
  signupSource="contact"
>
  <div class="container">
    <header class="page-head">
      <span class="pill">Contact</span>
      <h1 class="title-xl">
        Let’s <em>talk</em>
      </h1>
    </header>

    <div class="contact-grid">
      <aside class="contact-side">
        <p class="lead">
          A question about a guide, a topic you would like covered, a tool that changed since an
          article was written, or something you think I got wrong. I read every message myself
          and reply within one working day.
        </p>
        <div class="direct">
          <span>Direct contact</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="card">
          <h2>What happens next</h2>
          <p>I reply within one working day. Corrections are checked and, where they hold up, the article is updated and dated.</p>
          <p>Bought one of the PDF editions before the guides became free? Write from the address you paid with and I will help.</p>
        </div>
        <p class="legal-note">
          The Uncomplicated Guides are written by {site.author.name} and published by {site.legalTraderName}, {site.author.city}.
          Legal details are in the <a href="/imprint">imprint</a>.
        </p>
      </aside>
      <ContactForm />
    </div>
  </div>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 40px clamp(32px, 6vw, 96px);
    align-items: start;
    padding-bottom: clamp(72px, 10vw, 140px);
  }
  .contact-side {
    display: grid;
    gap: 32px;
  }
  .direct {
    display: grid;
    gap: 6px;
  }
  .direct span {
    font-size: 14px;
    color: var(--muted);
  }
  .direct a {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.04em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .direct a:hover {
    color: var(--accent-text);
  }
  .card h2 {
    font-size: 22px;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }
  .card p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .card p + p {
    margin-top: 12px;
  }
  .legal-note {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .legal-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
