---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { availableGuides, upcomingGuides } from '../../data/guides';
---
<Base title="The guide library" current="Library" description="Practical PDF guides to voice AI assistants and AI video ads. Read real sample pages before choosing.">
  <section class="container library">
    <p class="eyebrow">The library</p><h1 class="display">What will you build next?</h1>
    <p class="lead intro">Two practical playbooks. $39 each, once. Start with a free sample and choose the workflow that fits your next project.</p>
    <div class="cards">{availableGuides.map(guide => <GuideCard guide={guide} />)}</div>
    <aside class="recovery">Already a reader? <a href="/account">Open My guides to download again →</a></aside>
    <section class="upcoming"><p class="eyebrow">In progress</p><h2 class="display">Coming to the library.</h2><ul>{upcomingGuides.map(g=><li><div><h3><a href={`/guides/${g.slug}`}>{g.title}</a></h3><p>{g.short}</p></div><a class="arrow-link" href={`/guides/${g.slug}#notify`}>Get notified →</a></li>)}</ul></section>
  </section>
</Base>
<style>
.library{padding-top:56px;padding-bottom:80px}h1{font-size:clamp(32px,5vw,54px);line-height:1.2;letter-spacing:-.04em;margin:16px 0 20px}.intro{max-width:700px;margin-bottom:36px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.recovery{padding:24px 0;color:var(--text);font-size:15px}.upcoming{margin-top:50px}h2{font-size:clamp(25px,3vw,34px);letter-spacing:-.03em}.upcoming ul{padding:0;list-style:none}.upcoming li{display:flex;gap:30px;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding:24px 0}.upcoming li>div{max-width:740px}h3{font-size:20px;margin:0 0 8px}h3 a{color:var(--ink)}.upcoming p{margin:0;color:var(--text)}.upcoming .arrow-link{flex:none}@media(max-width:720px){.cards{grid-template-columns:1fr}.upcoming li{align-items:start;flex-direction:column;gap:16px}.library{padding-top:36px}}
</style>
