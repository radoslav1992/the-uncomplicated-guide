---
import Base from "../../layouts/Base.astro";
import GuideFeature from "../../components/GuideFeature.astro";
import SignupForm from "../../components/SignupForm.astro";
import { site } from "../../data/site";
import { getGuides, postUrl } from "../../lib/blog";

const guides = await getGuides();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Free guides — ${site.name}`,
  url: `${site.url}/guides`,
  description:
    "Free long-form guides to building and selling AI services: AI receptionists and voice agents, AI UGC video ads, and more on the way.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: guides.map((guide, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${site.url}${postUrl(guide)}`,
      name: guide.data.title,
    })),
  },
};
---

<Base
  title="Free guides to building and selling AI services"
  description="Free long-form guides to AI receptionists, voice agents and AI UGC video ads: strategy, build, testing, costs and pricing — every chapter on one page."
  current="Guides"
  jsonLd={jsonLd}
>
  <div class="listing-page">
    <section class="frame listing-intro">
      <p class="section-index">[ THE FREE GUIDES ]</p>
      <h1>
        Long reads.
        <br />
        <em>No paywall.</em>
      </h1>
      <p class="lead">
        Complete, chaptered guides to putting AI to work for real clients —
        from deciding whether a project is worth doing, through the build and
        the testing, to what to charge for it. Every chapter is on one page, with
        the prompts, tables and checklists inline.
      </p>
      <div class="listing-facts">
        <span><i class="status-dot"></i>{guides.length} guides</span>
        <span><i class="status-dot"></i>Free, no sign-up</span>
        <span><i class="status-dot"></i>Use the checklists with your clients</span>
      </div>
    </section>

    <section class="frame listing-section" aria-labelledby="guides-heading">
      <div class="section-head">
        <h2 id="guides-heading">Read now</h2>
        <p>Newest first</p>
      </div>
      <div class="guide-grid">
        {guides.map((guide) => (
          <GuideFeature post={guide} />
        ))}
      </div>
    </section>

    {site.upcoming.length > 0 && (
      <section class="frame listing-section" aria-labelledby="upcoming-heading">
        <div class="section-head">
          <h2 id="upcoming-heading">On the writing desk</h2>
          <p>Subscribe and get the day they are published</p>
        </div>
        <ul class="upcoming-list">
          {site.upcoming.map((item, i) => (
            <li data-reveal>
              <span class="upcoming-number" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              <a class="arrow-link" href="#notify">
                Get notified ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="notify" class="frame newsletter-section guides-signup">
      <div class="newsletter-copy">
        <p class="section-index">[ NEWSLETTER ]</p>
        <h2 class="display">Hear when the next guide is out.</h2>
        <p>
          One email on the day a guide is published, plus the occasional short
          note. Never more than a couple a month.
        </p>
      </div>
      <div class="newsletter-form">
        <SignupForm source="guides" buttonLabel="Tell me ↗" />
      </div>
    </section>
  </div>
</Base>

<style>
  .guides-signup {
    margin-bottom: 70px;
    scroll-margin-top: 110px;
  }
  .guides-signup h2 {
    font: 300 clamp(26px, 3vw, 40px) / 1.08 var(--font-display);
    text-transform: uppercase;
    margin: 0;
  }
</style>
