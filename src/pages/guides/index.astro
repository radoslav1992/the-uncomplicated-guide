---
import Base from "../../layouts/Base.astro";
import GuideCard from "../../components/GuideCard.astro";
import Icon from "../../components/Icon.astro";
import { availableGuides, upcomingGuides } from "../../data/guides";
---

<Base
  title="The guide library"
  current="Library"
  description="Practical PDF guides to voice AI assistants and AI video ads. Read real sample pages before choosing."
>
  <section class="library-intro">
    <div class="container">
      <p class="eyebrow">The practical collection</p>
      <h1>
        Make room for
        <br />
        <em>your next good idea.</em>
      </h1>
      <p class="lead">
        Practical playbooks for putting AI to work. Read a free sample, choose
        your next project, and take it one useful step at a time.
      </p>
      <div class="library-facts">
        <span>
          <Icon name="book" size={16} /> {availableGuides.length} guides
          available
        </span>
        <span>
          <Icon name="check" size={16} /> One payment per guide
        </span>
      </div>
    </div>
  </section>
  <section class="container library">
    <div class="shelf-heading">
      <h2>On the bookshelf</h2>
      <span>PDF editions / English</span>
    </div>
    <div class="cards">
      {availableGuides.map((guide) => (
        <div data-reveal>
          <GuideCard guide={guide} />
        </div>
      ))}
    </div>
    <aside class="recovery">
      <span>
        <Icon name="download" size={20} /> Already a reader?
      </span>
      <a href="/account">
        Open My guides to download again <Icon name="arrow" size={17} />
      </a>
    </aside>
    {upcomingGuides.length > 0 && (
      <section class="upcoming">
        <div class="upcoming-heading" data-reveal>
          <p class="eyebrow">Currently on the writing desk</p>
          <h2>
            There’s more <em>to come.</em>
          </h2>
          <p>
            These guides are still in progress. Get a note when yours is ready.
          </p>
        </div>
        <ul>
          {upcomingGuides.map((g, i) => (
            <li data-reveal>
              <span class="upcoming-number" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>
                  <a href={`/guides/${g.slug}`}>{g.title}</a>
                </h3>
                <p>{g.short}</p>
              </div>
              <a
                class="arrow-link"
                href={`/guides/${g.slug}#notify`}
                aria-label={`Get notified about ${g.title}`}
              >
                Get notified <Icon name="arrow" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>
</Base>
<style>
  .library-intro {
    background: linear-gradient(110deg, #fcfaf5, #f1e5d0);
    padding: 62px 0 48px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(39px, 5.4vw, 66px);
    line-height: 1.12;
    letter-spacing: -0.055em;
    margin: 18px 0 22px;
  }
  em {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: -0.045em;
  }
  .lead {
    max-width: 590px;
    font-size: 16px;
    line-height: 1.8;
  }
  .library-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
    font-size: 12px;
    color: var(--text);
  }
  .library-facts span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .library-facts :global(svg) {
    color: var(--accent);
  }
  .library {
    padding-top: 46px;
    padding-bottom: 80px;
  }
  .shelf-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .shelf-heading h2 {
    font-size: 22px;
    font-weight: 550;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .shelf-heading > span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .cards > div {
    display: flex;
    min-width: 0;
  }
  .cards :global(.guide-card) {
    width: 100%;
  }
  .recovery {
    padding: 22px 25px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    font-size: 13px;
  }
  .recovery span,
  .recovery a {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .recovery a {
    color: var(--ink);
  }
  .upcoming {
    margin-top: 75px;
  }
  .upcoming-heading {
    max-width: 540px;
  }
  .upcoming h2 {
    font-size: clamp(30px, 3.5vw, 42px);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 12px 0;
  }
  .upcoming-heading > p:last-child {
    color: var(--text);
    font-size: 15px;
    line-height: 1.8;
  }
  .upcoming ul {
    padding: 0;
    list-style: none;
    margin: 30px 0 0;
  }
  .upcoming li {
    display: grid;
    grid-template-columns: 45px 1fr auto;
    gap: 25px;
    align-items: center;
    border-top: 1px solid var(--border);
    padding: 28px 0;
  }
  .upcoming li > div {
    max-width: 720px;
  }
  .upcoming-number {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 30px;
    color: #9c8060;
  }
  h3 {
    font-size: 21px;
    line-height: 1.4;
    letter-spacing: -0.025em;
    font-weight: 550;
    margin: 0 0 8px;
  }
  h3 a {
    color: var(--ink);
  }
  .upcoming li p {
    margin: 0;
    color: var(--text);
    font-size: 14px;
    line-height: 1.8;
  }
  .upcoming .arrow-link {
    font-size: 12px;
  }
  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .library-intro {
      padding: 40px 0 30px;
    }
    .library {
      padding-top: 32px;
      padding-bottom: 50px;
    }
    .upcoming li {
      grid-template-columns: 30px 1fr;
      gap: 15px;
    }
    .upcoming .arrow-link {
      grid-column: 2;
    }
    .upcoming {
      margin-top: 50px;
    }
    .recovery {
      align-items: start;
      flex-direction: column;
      padding: 18px;
    }
    .recovery a {
      font-size: 12px;
    }
    .shelf-heading {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
