---
/**
 * GET /download/<token>
 * Streams the PDF from R2 for a valid, unexpired token. Otherwise renders a
 * short page that points back to the thank-you page (which reissues links).
 */
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getGuide } from '../../data/guides';
import { site } from '../../data/site';
import { getPurchaseByToken, linkExpired, recordDownload } from '../../lib/purchases';

export const prerender = false;

Astro.response.headers.set('cache-control', 'private, no-store');

const token = Astro.params.token ?? '';
const purchase = /^[A-Za-z0-9_-]{20,}$/.test(token) ? await getPurchaseByToken(env, token) : null;
const guide = purchase ? getGuide(purchase.guide) : undefined;

type State = 'invalid' | 'expired' | 'missing-file';
let state: State = 'invalid';

if (purchase && purchase.token === token && guide) {
  if (linkExpired(purchase)) {
    state = 'expired';
    Astro.response.status = 410;
  } else if (guide.fileKey) {
    const object = await env.GUIDE_FILES.get(guide.fileKey);
    if (object) {
      Astro.locals.cfContext?.waitUntil(recordDownload(env, purchase));
      const headers = new Headers();
      object.writeHttpMetadata(headers);
      headers.set('content-type', 'application/pdf');
      headers.set('content-length', String(object.size));
      headers.set('etag', object.httpEtag);
      headers.set('cache-control', 'private, no-store');
      headers.set('x-robots-tag', 'noindex');
      headers.set(
        'content-disposition',
        `attachment; filename="${(guide.fileName ?? guide.fileKey).replace(/["\\]/g, '')}"`,
      );
      return new Response(object.body, { headers });
    }
    state = 'missing-file';
  } else {
    state = 'missing-file';
  }
}

if (state === 'missing-file') Astro.response.status = 503;
if (state === 'invalid') Astro.response.status = 404;

const thankYou = purchase ? `/thank-you?session_id=${encodeURIComponent(purchase.sessionId)}` : '';
---

<Base title="Download" noindex>
  <div class="container wrap">
    <p class="eyebrow">Download</p>
    {
      state === 'expired' && (
        <Fragment>
          <h1 class="display">This link has expired.</h1>
          <p class="lead">
            Download links stay valid for {site.downloadLinkDays} days. Reopening the page Stripe returned you to
            issues a fresh one straight away.
          </p>
          <a href={thankYou} class="btn btn-accent">Get a fresh link →</a>
        </Fragment>
      )
    }
    {
      state === 'invalid' && (
        <Fragment>
          <h1 class="display">That link is not valid.</h1>
          <p class="lead">
            It may have been replaced by a newer one — each purchase has one current link. Open the most recent
            email, or write to <a href={`mailto:${site.email}`}>{site.email}</a> from the address you paid with.
          </p>
          <a href="/contact" class="btn btn-outline">Contact</a>
        </Fragment>
      )
    }
    {
      state === 'missing-file' && (
        <Fragment>
          <h1 class="display">The file is not available right now.</h1>
          <p class="lead">
            Your purchase is fine — the file is temporarily unavailable on this side. Please try again in a
            little while, or write to <a href={`mailto:${site.email}`}>{site.email}</a> and I will send it
            directly.
          </p>
          {thankYou && <a href={thankYou} class="btn btn-outline">Back to your purchase</a>}
        </Fragment>
      )
    }
  </div>
</Base>

<style>
  .wrap {
    padding-top: 96px;
    padding-bottom: 120px;
    max-width: 720px;
  }
  h1 {
    font-size: clamp(30px, 5vw, 46px);
    letter-spacing: -0.035em;
    margin: 12px 0 16px;
  }
  .lead {
    margin: 0 0 28px;
  }
</style>
