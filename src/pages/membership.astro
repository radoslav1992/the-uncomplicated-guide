---
import Base from '../layouts/Base.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import GuideCover from '../components/GuideCover.astro';
import { membership, plans } from '../data/plans';
import { formatPrice } from '../data/site';
import { guides, availableGuides, upcomingGuides, featuredGuide } from '../data/guides';

const monthly = plans.find((p) => p.id === 'monthly')!;
const yearly = plans.find((p) => p.id === 'yearly')!;

const FAQ = [
  {
    q: 'What do I get right now?',
    a: `Every guide that is on sale today (${availableGuides.length} at the moment) as a PDF download from your account, plus every guide that ships while you are a member — ${upcomingGuides.length} are in progress.`,
  },
  {
    q: 'How do I sign in?',
    a: 'There is no password. Enter the email you paid with on the account page and you get a sign-in link that works for 20 minutes. Your browser then stays signed in for a month.',
  },
  {
    q: 'Can I cancel?',
    a: 'Yes, any time, from the account page — it opens Stripe’s billing portal. Access continues to the end of the period you have paid for and nothing renews after that.',
  },
  {
    q: 'What happens to the files if I cancel?',
    a: 'Files you have already downloaded are yours to keep and use under the same licence as a bought guide. Downloading new or revised files needs an active membership.',
  },
  {
    q: 'Is it cheaper than buying the guides?',
    a: `A single guide is ${formatPrice(featuredGuide.price, featuredGuide.currency)}. The yearly membership is ${formatPrice(yearly.price, yearly.currency)}, so it pays for itself with the third guide — and the three in progress are included the day they ship.`,
  },
  {
    q: 'How is payment handled?',
    a: 'Through Stripe, like everything else here. Your card details never touch this site. You get a Stripe receipt for every renewal and can update the card in the billing portal.',
  },
];
---

<Base
  title="Membership"
  description={membership.tagline}
  current="Membership"
  image={featuredGuide.cover}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{membership.name}</p>
        <h1 class="display">Every guide. <span>One membership.</span></h1>
        <p class="lead">{membership.description}</p>
        <p class="small">
          From {formatPrice(monthly.price, monthly.currency)} a month or {formatPrice(yearly.price, yearly.currency)} a year. Prices include VAT.
        </p>
      </div>
      <PlanCards />
    </div>
  </section>

  <section class="section-alt shelf">
    <div class="container">
      <p class="eyebrow">What is on the shelf</p>
      <h2 class="display">{availableGuides.length} available now, {upcomingGuides.length} on the way</h2>
      <ul class="covers">
        {
          guides.map((g) => (
            <li>
              <GuideCover guide={g} size="shelf" href={`/guides/${g.slug}`} />
              <p class="t">{g.title}</p>
              <p class="s">{g.status === 'available' ? `${g.pages} pages · included` : 'In progress · included when it ships'}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="display">Before you subscribe</h2>
        <p class="lead-text">Anything else, <a href="/contact" class="inline-link">write to me</a>. Members get the same one-working-day reply as everyone.</p>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(48px, 7vw, 92px) 0 clamp(56px, 8vw, 96px);
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 60% at 82% 30%, rgba(226, 84, 43, 0.1), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  h1 {
    font-size: clamp(34px, 5.4vw, 62px);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 14px 0 0;
  }
  h1 span {
    color: var(--accent);
  }
  .hero .lead {
    margin: 22px 0 0;
    max-width: 48ch;
  }
  .hero .small {
    margin: 18px 0 0;
  }
  .shelf {
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .shelf h2 {
    font-size: clamp(24px, 3.4vw, 40px);
    letter-spacing: -0.04em;
    margin: 14px 0 0;
  }
  .covers {
    list-style: none;
    margin: 40px 0 0;
    padding: 12px 0 0;
    overflow: hidden; /* clip the decorative glow behind the covers on narrow screens */
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px 20px;
  }
  .covers li {
    text-align: center;
  }
  .covers .t {
    margin: 14px 0 0;
    font-weight: 600;
    font-size: 15px;
  }
  .covers .s {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .faq-grid h2 {
    font-size: clamp(28px, 4.2vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 14px 0 0;
  }
  .lead-text {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text);
    margin: 18px 0 0;
    max-width: 34ch;
  }
  .inline-link {
    font-weight: 600;
    border-bottom: 1px solid var(--accent-tint);
  }
  @media (max-width: 860px) {
    .hero-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
