---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import SignupForm from "../../components/SignupForm.astro";
import { site } from "../../data/site";
import { categoriesWithPosts, getPosts, postUrl } from "../../lib/blog";

const posts = await getPosts();
const categoryCount = categoriesWithPosts(posts).length;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Articles — ${site.name}`,
    url: `${site.url}/blog`,
    description:
      "Every article on The Uncomplicated Guides: voice AI, AI video, side projects and selling AI services.",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((post, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site.url}${postUrl(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${site.url}/blog` },
    ],
  },
];
---

<Base
  title="Articles on AI receptionists, AI video and AI side projects"
  description="Every article in one place: AI receptionists and voice agents, AI UGC video ads, side projects built with AI, and how to price and sell AI services."
  current="Articles"
  jsonLd={jsonLd}
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Articles</p>
      <h1>Notes from the work</h1>
      <p class="lead">
        Practical articles on putting AI to work: what to build, what it costs,
        and what to check before you promise it to a client. Long step-by-step
        reads and short field notes, all free.
      </p>
      <ul class="facts">
        <li>{posts.length} articles</li>
        <li>{categoryCount} categories</li>
        <li>Free to read</li>
      </ul>
    </header>

    <section aria-labelledby="all-articles">
      <h2 id="all-articles" class="visually-hidden">All articles</h2>
      <CategoryNav posts={posts} />
      {posts.length === 0 && (
        <p class="lead">Nothing published yet. The first pieces are on their way.</p>
      )}
      <div class="card-grid">
        {posts.map((post) => (
          <ArticleCard post={post} headingLevel={3} />
        ))}
      </div>
    </section>

    <section class="home-section listing-signup">
      <div class="signup-box">
        <div>
          <p class="eyebrow">Newsletter</p>
          <h2>One email when there is something worth reading.</h2>
          <p>
            New articles go out on one list — a couple of emails a month at most,
            and one click to leave.
          </p>
        </div>
        <SignupForm source="blog" />
      </div>
    </section>
  </div>
</Base>
