---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import SignupForm from "../../components/SignupForm.astro";
import { site } from "../../data/site";
import { categoriesWithPosts, getPosts, postUrl } from "../../lib/blog";

const posts = await getPosts();
const categoryCount = categoriesWithPosts(posts).length;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Articles — ${site.name}`,
    url: `${site.url}/blog`,
    description:
      "Every article on The Uncomplicated Guides: voice AI, AI video, side projects and selling AI services.",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((post, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site.url}${postUrl(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${site.url}/blog` },
    ],
  },
];
---

<Base
  title="Articles on AI receptionists, AI video and AI side projects"
  description="Every article in one place: AI receptionists and voice agents, AI UGC video ads, side projects built with AI, and how to price and sell AI services."
  current="Articles"
  jsonLd={jsonLd}
>
  <div class="listing-page">
    <section class="frame listing-intro">
      <p class="section-index">[ THE JOURNAL ]</p>
      <h1>
        Notes from
        <br />
        <em>the work.</em>
      </h1>
      <p class="lead">
        Practical articles on putting AI to work: what to build, what it costs,
        and what to check before you promise it to a client. Long step-by-step
        reads and short field notes, all free.
      </p>
      <div class="listing-facts">
        <span><i class="status-dot"></i>{posts.length} articles</span>
        <span><i class="status-dot"></i>{categoryCount} categories</span>
        <span><i class="status-dot"></i>Free to read</span>
      </div>
    </section>

    <section class="frame listing-section journal" aria-labelledby="all-articles">
      <div class="section-head">
        <h2 id="all-articles">All articles</h2>
        <p>Newest first</p>
      </div>
      <CategoryNav posts={posts} />
      {posts.length === 0 && (
        <p class="lead">Nothing published yet. The first pieces are on their way.</p>
      )}
      <div class="card-grid">
        {posts.map((post, i) => (
          <ArticleCard post={post} index={i} headingLevel={3} />
        ))}
      </div>
    </section>

    <section class="frame newsletter-section listing-signup">
      <div class="newsletter-copy">
        <p class="section-index">[ NEWSLETTER ]</p>
        <h2 class="display">One email when there is something worth reading.</h2>
        <p>
          New articles go out on one list — a couple of emails a month at most,
          and one click to leave.
        </p>
      </div>
      <div class="newsletter-form">
        <SignupForm source="blog" />
      </div>
    </section>
  </div>
</Base>
