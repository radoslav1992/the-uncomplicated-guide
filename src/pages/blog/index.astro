---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { site } from "../../data/site";
import { categoriesWithPosts, getPosts, postUrl } from "../../lib/blog";

const posts = await getPosts();
const categoryCount = categoriesWithPosts(posts).length;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Articles — ${site.name}`,
    url: `${site.url}/blog`,
    description:
      "Every article on The Uncomplicated Guides: voice AI, AI video, side projects and selling AI services.",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((post, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site.url}${postUrl(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${site.url}/blog` },
    ],
  },
];
---

<Base
  title="Articles on AI receptionists, AI video and AI side projects"
  description="Every article in one place: AI receptionists and voice agents, AI UGC video ads, side projects built with AI, and how to price and sell AI services."
  current="Articles"
  jsonLd={jsonLd}
  signupSource="blog"
>
  <div class="container">
    <header class="page-head">
      <span class="pill">Journal</span>
      <h1 class="title-xl">
        Notes from <em>the work</em>
      </h1>
      <div class="page-head-foot">
        <p class="lead">
          Practical articles on putting AI to work: what to build, what it costs,
          and what to check before you promise it to a client. Long step-by-step
          reads and short field notes, all free.
        </p>
        <ul class="facts">
          <li class="chip">{posts.length} articles</li>
          <li class="chip">{categoryCount} categories</li>
          <li class="chip">Free to read</li>
        </ul>
      </div>
    </header>

    <section class="listing" aria-labelledby="all-articles">
      <h2 id="all-articles" class="visually-hidden">All articles</h2>
      <CategoryNav posts={posts} />
      {posts.length === 0 && (
        <p class="lead">Nothing published yet. The first pieces are on their way.</p>
      )}
      <div class="card-grid">
        {posts.map((post, i) => (
          <ArticleCard post={post} index={i} headingLevel={3} />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .listing {
    padding-bottom: clamp(72px, 10vw, 140px);
  }
</style>
