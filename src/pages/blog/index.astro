---
import Base from '../../layouts/Base.astro';
import SignupForm from '../../components/SignupForm.astro';
import { getPosts, readingTime, postUrl } from '../../lib/blog';
import { formatDate } from '../../lib/http';

const posts = await getPosts();
---

<Base
  title="Blog"
  description="Short pieces on the same procedures the guides cover: what breaks, what it costs, and what to check before you promise it to a client."
  current="Blog"
>
  <section class="intro">
    <div class="intro-bg" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="display">Notes from the work.</h1>
      <p class="lead">
        Short pieces on the same procedures the guides cover: what breaks, what it costs, and what
        to check before you promise it to a client. No news, no roundups — the parts that are worth
        writing down once.
      </p>
    </div>
  </section>

  <section class="list-section">
    <div class="container">
      {posts.length === 0 && <p class="lead">Nothing published yet. The first pieces are on their way.</p>}
      <ol class="posts">
        {
          posts.map((post, i) => (
            <li class="post reveal" style={`--i: ${i}`}>
              <a href={postUrl(post)}>
                <p class="meta">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)} min read</span>
                  {post.data.draft && <span class="draft">Draft</span>}
                </p>
                <h2 class="display">{post.data.title}</h2>
                <p class="desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="tag-list">
                    {post.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
                <span class="arrow-link more">Read it →</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="signup-section">
    <div class="container">
      <div class="panel signup-panel">
        <div>
          <h2 class="display">One email when there is something worth reading.</h2>
          <p class="lead-text">
            New pieces and new guides go out on the same list — a couple of emails a month at most,
            and one click to leave.
          </p>
        </div>
        <SignupForm source="blog" />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding: clamp(48px, 7vw, 92px) 0 clamp(24px, 4vw, 40px);
    position: relative;
    overflow: hidden;
  }
  .intro-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 60% at 82% 30%, rgba(226, 84, 43, 0.1), transparent 70%);
    pointer-events: none;
  }
  .intro .container {
    position: relative;
  }
  .intro h1 {
    font-size: clamp(32px, 5.4vw, 62px);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 14px 0 0;
  }
  .intro .lead {
    margin: 22px 0 0;
    max-width: 58ch;
  }

  .list-section {
    padding: clamp(24px, 4vw, 48px) 0 clamp(56px, 8vw, 96px);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .post {
    border-bottom: 1px solid var(--border);
  }
  .post a {
    display: block;
    color: inherit;
    padding: clamp(28px, 4vw, 44px) 0;
    transition: color 0.18s ease;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .draft {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .post h2 {
    font-size: clamp(24px, 3.4vw, 38px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 12px 0 0;
    max-width: 22ch;
    transition: color 0.18s ease;
  }
  .post a:hover h2 {
    color: var(--accent);
  }
  .desc {
    font-size: clamp(15.5px, 1.7vw, 17.5px);
    line-height: 1.6;
    color: var(--text);
    margin: 12px 0 0;
    max-width: 62ch;
  }
  .more {
    margin-top: 20px;
  }

  .signup-section {
    padding: 0 0 clamp(72px, 10vw, 120px);
  }
  .signup-panel {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .signup-panel h2 {
    font-size: clamp(24px, 3.2vw, 34px);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .lead-text {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text);
    margin: 16px 0 0;
    max-width: 46ch;
  }
  @media (max-width: 860px) {
    .signup-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
