---
/**
 * One page per category with published articles: /blog/category/<slug>.
 * The intro text comes from src/data/categories.ts.
 */
import Base from "../../../layouts/Base.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import CategoryNav from "../../../components/CategoryNav.astro";
import { site } from "../../../data/site";
import { categoriesWithPosts, getPosts, postUrl } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return categoriesWithPosts(posts).map((category) => ({
    params: { category: category.slug },
    props: { category, posts },
  }));
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];

const { category, posts } = Astro.props;
const url = `${site.url}${category.url}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${category.name} — ${site.name}`,
    url,
    description: category.description,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: category.posts.map((post, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site.url}${postUrl(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${site.url}/blog` },
      { "@type": "ListItem", position: 3, name: category.name, item: url },
    ],
  },
];
---

<Base
  title={`${category.name} articles`}
  description={category.description}
  current="Articles"
  jsonLd={jsonLd}
  signupSource={`category:${category.slug}`}
  signupTopic={category.slug}
>
  <div class="container">
    <header class="page-head">
      <nav class="page-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>{" / "}<a href="/blog">Articles</a>{" / "}
        <span aria-current="page">{category.name}</span>
      </nav>
      <span class="pill">Category</span>
      <h1 class="title-xl">{category.name}</h1>
      <div class="page-head-foot">
        <p class="lead">{category.intro}</p>
        <ul class="facts">
          <li class="chip">
            {category.posts.length}
            {category.posts.length === 1 ? " article" : " articles"}
          </li>
          <li class="chip">Free to read</li>
        </ul>
      </div>
    </header>

    <section class="listing" aria-labelledby="category-articles">
      <h2 id="category-articles" class="visually-hidden">{category.name} articles</h2>
      <CategoryNav posts={posts} current={category.slug} />
      <div class="card-grid">
        {category.posts.map((post, i) => (
          <ArticleCard post={post} index={i} headingLevel={3} />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .listing {
    padding-bottom: clamp(72px, 10vw, 140px);
  }
</style>
