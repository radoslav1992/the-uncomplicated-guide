---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import GuideOffer from "../../components/GuideOffer.astro";
import portrait from "../../assets/portrait.webp";
import {
  getPosts,
  postCategory,
  postUrl,
  readingTime,
  relatedPosts,
  type Post,
} from "../../lib/blog";
import { categoryUrl } from "../../data/categories";
import { site } from "../../data/site";
import { formatDate } from "../../lib/http";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = await getPosts();
const minutes = readingTime(post.body);
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const chapters = headings.filter((h) => h.depth === 2);
// Long reads get a table of contents; short notes don't need one.
const showToc = chapters.length >= 5;
const related = relatedPosts(post, all, 3);
const category = postCategory(post);
const categoryHref = categoryUrl(category.slug);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const canonical = `${origin}${postUrl(post)}`;
const absolute = (src?: string) => (src ? new URL(src, `${origin}/`).href : undefined);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: absolute(post.data.socialImage ?? post.data.image),
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      "@type": "Person",
      name: site.author.name,
      url: `${origin}/#author`,
      jobTitle: site.author.role,
    },
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: `${origin}/`,
      logo: { "@type": "ImageObject", url: `${origin}/brand/next-chapter-192.png` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    articleSection: category.name,
    keywords: post.data.tags.join(", ") || undefined,
    wordCount: words,
    isAccessibleForFree: true,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${origin}/blog` },
      { "@type": "ListItem", position: 3, name: category.name, item: `${origin}${categoryHref}` },
      { "@type": "ListItem", position: 4, name: post.data.title, item: canonical },
    ],
  },
];
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  current="Articles"
  image={post.data.socialImage ?? post.data.image}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
    section: category.name,
  }}
  jsonLd={jsonLd}
  signupSource={`blog:${post.id}`.slice(0, 40)}
>
  <article class="post">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Articles</a></li>
          <li><a href={categoryHref}>{category.name}</a></li>
        </ol>
      </nav>

      <header class="post-head">
        <div class="post-meta">
          <ul class="chips">
            <li><a class="chip" href={categoryHref}>{category.name}</a></li>
            <li>
              <time class="chip" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </li>
            <li><span class="chip">{minutes} min read</span></li>
          </ul>
          <div class="written-by">
            <Image
              src={portrait}
              alt=""
              width={64}
              height={64}
              widths={[64, 128]}
              sizes="64px"
              loading="eager"
            />
            <p>
              <span>Written by</span>
              <a href="/#author">{site.author.name}</a>
              <span>{site.author.role}</span>
            </p>
          </div>
        </div>
        <div class="post-title">
          <h1>{post.data.title}</h1>
          <p class="standfirst">{post.data.description}</p>
          {post.data.updatedDate && (
            <p class="updated">
              Updated{" "}
              <time datetime={post.data.updatedDate.toISOString()}>
                {formatDate(post.data.updatedDate)}
              </time>
            </p>
          )}
        </div>
      </header>

      {post.data.image && (
        <figure class="post-hero">
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class:list={["post-grid", { "no-toc": !showToc, "no-hero": !post.data.image }]}>
        <aside class="post-rail">
          {showToc && (
            <nav class="toc" aria-label="In this article">
              <details open data-toc>
                <summary>In this article</summary>
                <ol>
                  {chapters.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc-link={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )}
        </aside>

        <div class="post-body">
          {post.data.takeaways && post.data.takeaways.length > 0 && (
            <aside class="takeaways" aria-labelledby="takeaways-heading">
              <p class="pill" id="takeaways-heading">Key takeaways</p>
              <ul>
                {post.data.takeaways.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </aside>
          )}
          <div class="prose" data-prose>
            <Content />
          </div>

          {/* The subscriber PDF covers voice agents, so it is offered on those articles. */}
          {post.data.category === "voice-ai" && (
            <GuideOffer source={`guide-offer:${post.id}`} topic={post.data.category} />
          )}

          <footer class="post-foot">
            {post.data.tags.length > 0 && (
              <div class="tags">
                <span>Tags:</span>
                <ul class="tag-list" aria-label="Topics">
                  {post.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            )}
            <div class="author-box">
              <Image
                src={portrait}
                alt=""
                width={96}
                height={96}
                widths={[96, 192]}
                sizes="96px"
                loading="lazy"
              />
              <div>
                <p class="author-label">Written by</p>
                <p class="author-name">{site.author.name}</p>
                <p class="author-bio">{site.author.bio}</p>
                <a href="/contact" class="arrow-link">Ask a question</a>
              </div>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="container">
        <div class="section-head">
          <span class="pill">Journal</span>
          <div class="section-title-row">
            <h2 id="related-heading" class="title-lg">
              Keep <em>reading</em>
            </h2>
            <a href={categoryHref} class="arrow-link">
              All {category.name} articles
            </a>
          </div>
        </div>
        <div class="card-grid">
          {related.map((p, i) => (
            <ArticleCard post={p} index={i} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Highlight the chapter being read in the table of contents: the last heading
  // that has scrolled past the top of the viewport, or none above the first one.
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink!))
    .filter((el): el is HTMLElement => Boolean(el));
  if (headings.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      let current = "";
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > 140) break;
        current = heading.id;
      }
      for (const link of tocLinks) {
        link.toggleAttribute("aria-current", link.dataset.tocLink === current);
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // On narrow screens the table of contents starts closed and closes after a jump.
  const toc = document.querySelector<HTMLDetailsElement>("[data-toc]");
  if (toc) {
    const narrow = window.matchMedia("(max-width: 1100px)");
    if (narrow.matches) toc.open = false;
    toc.addEventListener("click", (event) => {
      if (narrow.matches && (event.target as Element).closest("a")) toc.open = false;
    });
  }

  // A copy button on every code block, for the prompt templates.
  document.querySelectorAll<HTMLPreElement>("[data-prose] pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    pre.replaceWith(wrap);
    wrap.appendChild(pre);
    wrap.appendChild(button);
  });
</script>

<style>
  .post {
    --rail: 250px;
    --gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(24px, 3.4vw, 44px);
  }

  /* Breadcrumb */
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    gap: 6px;
  }
  .crumbs li + li::before {
    content: "/";
    color: var(--faint);
  }
  .crumbs a:hover,
  .crumbs li:last-child a {
    color: var(--ink);
  }

  /* Header: meta on the left rail, big title beside it (the theme's article header). */
  .post-head {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 28px var(--gap);
    align-items: start;
    padding: clamp(28px, 4vw, 52px) 0 clamp(32px, 5vw, 64px);
  }
  .post-meta {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vw, 72px);
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .written-by {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .written-by :global(img) {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 12px;
    object-fit: cover;
  }
  .written-by p {
    display: grid;
    gap: 3px;
    font-size: 14px;
    line-height: 1.25;
    color: var(--text-2);
  }
  .written-by a {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .written-by a:hover {
    color: var(--accent-text);
  }
  .post-title h1 {
    font-size: clamp(34px, 5vw, 76px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .standfirst {
    max-width: 58ch;
    margin-top: clamp(18px, 2.2vw, 30px);
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--text-2);
  }
  .updated {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Hero image */
  .post-hero {
    margin: 0;
  }
  .post-hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* Body: contents on the rail, text in a readable column beside it. */
  .post-grid {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 760px);
    gap: 28px var(--gap);
    align-items: start;
    padding: clamp(36px, 5vw, 72px) 0 clamp(56px, 8vw, 110px);
  }
  .post-grid.no-hero {
    border-top: 1px solid var(--border);
  }
  .post-rail {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    max-height: calc(100vh - var(--header-h) - 48px);
    overflow-y: auto;
  }
  .post-body {
    min-width: 0;
  }

  /* Table of contents */
  .toc summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    color: var(--muted);
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .toc a {
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-2);
    transition:
      color 0.2s ease,
      padding 0.25s ease;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    padding-left: 14px;
    color: var(--ink);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  /* Key takeaways */
  .takeaways {
    margin: 0 0 clamp(32px, 4vw, 48px);
    padding: clamp(22px, 3vw, 34px);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  .takeaways ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .takeaways li {
    position: relative;
    padding-left: 28px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink);
  }
  .takeaways li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Copy button on code blocks */
  .post-body :global(.code-wrap) {
    position: relative;
  }
  .post-body :global(.copy-code) {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 14px;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .post-body :global(.copy-code:hover) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  /* Footer of the article */
  .post-foot {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .tags {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
    font-family: var(--font-display);
    font-size: 19px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .tags :global(.tag-list) {
    font-family: var(--font-body);
    letter-spacing: 0;
  }
  .author-box {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 24px;
    align-items: start;
    padding: clamp(22px, 3vw, 34px);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  .author-box :global(img) {
    width: 96px;
    height: 96px;
    border-radius: 12px;
    object-fit: cover;
  }
  .author-label {
    font-size: 14px;
    color: var(--muted);
  }
  .author-name {
    margin: 2px 0 10px;
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .author-bio {
    margin-bottom: 16px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-2);
  }

  /* Related articles */
  .related {
    padding: clamp(56px, 8vw, 120px) 0 clamp(72px, 10vw, 140px);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 1100px) {
    .post-head,
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-meta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px 32px;
      order: 2;
    }
    .chips {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .post-grid {
      max-width: 760px;
    }
    .post-rail {
      position: static;
      max-height: none;
    }
    .no-toc .post-rail {
      display: none;
    }
    .toc {
      padding: 4px 20px;
      border: 1px solid var(--border-2);
      border-radius: var(--radius);
    }
    .toc summary {
      padding: 14px 0;
      font-weight: 500;
      color: var(--ink);
    }
    .toc summary::after {
      content: "+";
      font-size: 22px;
      font-weight: 300;
      line-height: 1;
    }
    .toc details[open] summary::after {
      content: "–";
    }
    .toc li:last-child a {
      border-bottom: 0;
    }
  }
  @media (max-width: 600px) {
    .author-box {
      grid-template-columns: 1fr;
    }
  }
</style>
