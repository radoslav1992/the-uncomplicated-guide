---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SignupForm from "../../components/SignupForm.astro";
import portrait from "../../assets/portrait.webp";
import {
  getPosts,
  isGuide,
  postUrl,
  readingTime,
  relatedPosts,
  type Post,
} from "../../lib/blog";
import { site } from "../../data/site";
import { formatDate } from "../../lib/http";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = await getPosts();
const guide = isGuide(post);
const minutes = readingTime(post.body);
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const chapters = headings.filter((h) => h.depth === 2);
const showToc = guide || chapters.length >= 5;

// The guide this article belongs with, and — on a guide — the articles that go deeper.
const parentGuide = post.data.guide
  ? all.find((p) => p.id === post.data.guide && isGuide(p))
  : undefined;
const deeper = guide ? all.filter((p) => p.data.guide === post.id) : [];
const related = relatedPosts(
  post,
  all.filter((p) => !deeper.includes(p) && p.id !== parentGuide?.id),
  3,
);

const section = guide
  ? { name: "Guides", href: "/guides" }
  : { name: "Articles", href: "/blog" };
const label = guide ? "Free guide" : (post.data.tags[0] ?? "Article");

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const canonical = `${origin}${postUrl(post)}`;
const absolute = (src?: string) => (src ? new URL(src, `${origin}/`).href : undefined);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": guide ? "Article" : "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: absolute(post.data.socialImage ?? post.data.image),
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      "@type": "Person",
      name: site.author.name,
      url: `${origin}/#author`,
      jobTitle: site.author.role,
    },
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: `${origin}/`,
      logo: { "@type": "ImageObject", url: `${origin}/brand/next-chapter-192.png` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    articleSection: section.name,
    keywords: post.data.tags.join(", ") || undefined,
    wordCount: words,
    isAccessibleForFree: true,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: section.name, item: `${origin}${section.href}` },
      { "@type": "ListItem", position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  current={guide ? "Guides" : "Articles"}
  image={post.data.socialImage ?? post.data.image}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
    section: section.name,
  }}
  jsonLd={jsonLd}
>
  <article class:list={["post", { "is-guide": guide }]}>
    <header class="head container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={section.href}>{section.name}</a></li>
          <li aria-current="page">{post.data.title}</li>
        </ol>
      </nav>
      <p class="meta">
        <span class:list={["kind", { guide }]}>{label}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {guide && chapters.length > 0 && (
          <Fragment>
            <span aria-hidden="true">·</span>
            <span>{chapters.length} chapters</span>
          </Fragment>
        )}
      </p>
      <h1 class="display">{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
      <p class="byline-top">
        By <a href="/#author">{site.author.name}</a>
        {post.data.updatedDate && (
          <Fragment>
            {" "}· Updated{" "}
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </Fragment>
        )}
      </p>
    </header>

    {post.data.image && (
      <figure class="hero container">
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}

    <div class:list={["layout container", { "with-toc": showToc }]}>
      {showToc && (
        <aside class="toc" aria-label={guide ? "In this guide" : "In this article"}>
          <details open data-toc>
            <summary>{guide ? "In this guide" : "In this article"}</summary>
            <ol>
              {chapters.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </aside>
      )}

      <div class="body prose" data-prose>
        <Content />
      </div>
    </div>

    <footer class="foot container">
      {post.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="Topics">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
      {guide && (
        <p class="use-note">
          Free to read and free to use: take the prompts, tables and checklists
          into your own work and your clients' projects. If you share the guide,
          link to this page rather than copying it.
        </p>
      )}
      <div class="author-box">
        <Image
          src={portrait}
          alt=""
          width={96}
          height={96}
          widths={[96, 192]}
          sizes="96px"
          loading="lazy"
        />
        <div>
          <p class="author-label">Written by</p>
          <p class="author-name">{site.author.name}</p>
          <p class="author-bio">{site.author.bio}</p>
          <a href="/contact" class="arrow-link">Ask a question ↗</a>
        </div>
      </div>
    </footer>
  </article>

  {parentGuide && (
    <section class="container parent-guide">
      <a href={postUrl(parentGuide)} class="parent-card">
        {parentGuide.data.image && (
          <img src={parentGuide.data.image} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        )}
        <span class="parent-copy">
          <span class="parent-label">The full guide · free</span>
          <span class="parent-title">{parentGuide.data.title}</span>
          <span class="parent-desc">{parentGuide.data.description}</span>
          <span class="parent-cta">
            Read the guide · {readingTime(parentGuide.body)} min <span aria-hidden="true">↗</span>
          </span>
        </span>
      </a>
    </section>
  )}

  {(deeper.length > 0 || related.length > 0) && (
    <section class="more">
      <div class="frame journal more-frame">
        {deeper.length > 0 && (
          <Fragment>
            <div class="more-head">
              <p class="section-index">[ GO DEEPER ]</p>
              <h2>Articles that expand this guide</h2>
            </div>
            <div class="card-grid">
              {deeper.map((p, i) => (
                <ArticleCard post={p} index={i} />
              ))}
            </div>
          </Fragment>
        )}
        {related.length > 0 && (
          <Fragment>
            <div class="more-head">
              <p class="section-index">[ KEEP READING ]</p>
              <h2>{deeper.length > 0 ? "More from the journal" : "Related articles"}</h2>
            </div>
            <div class="card-grid">
              {related.map((p, i) => (
                <ArticleCard post={p} index={i} />
              ))}
            </div>
          </Fragment>
        )}
      </div>
    </section>
  )}

  <section class="frame newsletter-section post-signup">
    <div class="newsletter-copy">
      <p class="section-index">[ NEWSLETTER ]</p>
      <p class="signup-title">Get the next one.</p>
      <p>
        One email when a new guide or article is published. A couple a month
        at most, one click to leave.
      </p>
    </div>
    <div class="newsletter-form">
      <SignupForm source={`blog:${post.id}`.slice(0, 40)} />
    </div>
  </section>
</Base>

<script>
  // Highlight the chapter being read in the table of contents.
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    .forEach((a) => links.set(a.dataset.tocLink!, a));
  if (links.size && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const order = [...links.keys()];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const current = order.find((id) => visible.has(id));
        if (!current) return;
        links.forEach((a, id) =>
          a.toggleAttribute("aria-current", id === current),
        );
      },
      { rootMargin: "-90px 0px -65% 0px" },
    );
    order.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // On narrow screens the table of contents starts closed and closes after a jump.
  const toc = document.querySelector<HTMLDetailsElement>("[data-toc]");
  if (toc) {
    const narrow = window.matchMedia("(max-width: 1050px)");
    if (narrow.matches) toc.open = false;
    toc.addEventListener("click", (event) => {
      if (narrow.matches && (event.target as Element).closest("a")) toc.open = false;
    });
  }

  // A copy button on every code block, for the prompt templates.
  document.querySelectorAll<HTMLPreElement>("[data-prose] pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    pre.replaceWith(wrap);
    wrap.appendChild(pre);
    wrap.appendChild(button);
  });
</script>

<style>
  .head {
    padding-top: clamp(32px, 5vw, 64px);
    max-width: 860px;
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 24px;
    padding: 0;
    font-size: 12px;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    gap: 6px;
    min-width: 0;
  }
  .crumbs li + li::before {
    content: "/";
    color: var(--faint);
  }
  .crumbs li[aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 42ch;
  }
  .crumbs a {
    color: var(--text-2);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kind.guide {
    background: var(--accent);
    color: #111;
    font-weight: 700;
    padding: 5px 8px;
  }
  .head h1 {
    font-size: clamp(32px, 5.4vw, 64px);
    line-height: 1.04;
    margin: 18px 0 0;
  }
  .standfirst {
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.6;
    color: var(--text);
    margin: 20px 0 0;
    max-width: 62ch;
  }
  .byline-top {
    font-size: 14px;
    color: var(--muted);
    margin: 18px 0 0;
  }
  .byline-top a {
    color: var(--ink);
  }
  .hero {
    max-width: 1100px;
    margin: clamp(28px, 4vw, 44px) auto 0;
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .layout {
    max-width: 860px;
    padding-top: clamp(28px, 4vw, 48px);
  }
  .layout.with-toc {
    max-width: 1180px;
    display: grid;
    grid-template-columns: 260px minmax(0, 760px);
    justify-content: center;
    gap: 56px;
    align-items: start;
  }
  .toc {
    position: sticky;
    top: 112px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    border-top: 1px solid var(--border);
  }
  .toc summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary::after {
    content: "+";
    color: var(--accent);
    font-size: 16px;
    line-height: 1;
  }
  .toc details[open] summary::after {
    content: "–";
  }
  .toc ol {
    list-style: none;
    counter-reset: toc;
    margin: 0;
    padding: 0 0 14px;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 6px;
    padding: 7px 0;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--text);
    border-left: 2px solid transparent;
    transition: color 0.2s;
  }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-size: 11px;
    padding-top: 2px;
    color: var(--muted);
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--ink);
  }
  .toc a[aria-current]::before {
    color: var(--accent);
  }
  .body {
    min-width: 0;
  }
  .body :global(h2),
  .body :global(h3) {
    scroll-margin-top: 110px;
  }
  .body :global(.code-wrap) {
    position: relative;
  }
  .body :global(.copy-code) {
    position: absolute;
    top: 10px;
    right: 10px;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 7px 10px;
    border: 1px solid #0002;
    background: #fff;
    color: #111;
    cursor: pointer;
  }
  .body :global(.copy-code:hover) {
    background: var(--accent);
  }

  .foot {
    max-width: 860px;
    padding-top: 28px;
    padding-bottom: clamp(48px, 7vw, 72px);
  }
  /* Line the footer up with the text column, not the table of contents. */
  .with-toc + .foot {
    max-width: 1180px;
    display: grid;
    grid-template-columns: 260px minmax(0, 760px);
    justify-content: center;
    column-gap: 56px;
  }
  .with-toc + .foot > * {
    grid-column: 2;
  }
  .foot .tag-list {
    margin: 0 0 22px;
  }
  .use-note {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text);
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 16px;
    margin: 0 0 28px;
    max-width: 70ch;
  }
  .author-box {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 22px;
    align-items: start;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    max-width: 760px;
  }
  .author-box :global(img) {
    width: 96px;
    height: 96px;
    object-fit: cover;
    filter: grayscale(1);
  }
  .author-label {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .author-name {
    margin: 4px 0 8px;
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
  }
  .author-bio {
    margin: 0 0 12px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text);
  }

  .parent-guide {
    max-width: 1180px;
    padding-bottom: clamp(48px, 7vw, 72px);
  }
  .parent-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink);
    transition: border-color 0.25s;
  }
  .parent-card:hover {
    border-color: var(--accent);
  }
  .parent-card img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .parent-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(22px, 3vw, 34px);
  }
  .parent-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .parent-title {
    font: 300 clamp(24px, 2.6vw, 34px) / 1.08 var(--font-display);
    text-transform: uppercase;
  }
  .parent-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
  }
  .parent-cta {
    margin-top: auto;
    font-size: 13px;
    font-weight: 600;
  }
  .parent-cta span {
    color: var(--accent);
    font-size: 18px;
    margin-left: 4px;
  }

  .more {
    border-top: 1px solid var(--border);
  }
  .more-frame {
    width: calc(100% - var(--gutter) * 2);
    max-width: 1320px;
    margin-inline: auto;
    border-inline: 1px solid var(--border);
  }
  .more-head {
    padding: 48px 22px 26px;
  }
  .more-head .section-index {
    margin: 0 0 12px;
  }
  .more-head h2 {
    font: 300 clamp(26px, 3vw, 40px) / 1.05 var(--font-display);
    text-transform: uppercase;
    margin: 0;
  }
  .more :global(.card-grid > *) {
    border-bottom: 0;
  }

  .post-signup {
    width: calc(100% - var(--gutter) * 2);
    max-width: 1320px;
    margin: 0 auto 70px;
  }
  .signup-title {
    font: 300 clamp(28px, 3.4vw, 46px) / 1.05 var(--font-display) !important;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  @media (max-width: 1050px) {
    .layout.with-toc {
      display: block;
      max-width: 860px;
    }
    .with-toc + .foot {
      display: block;
      max-width: 860px;
    }
    .toc {
      position: static;
      max-height: none;
      margin-bottom: 32px;
      border-bottom: 1px solid var(--border);
    }
  }
  @media (max-width: 720px) {
    .parent-card {
      grid-template-columns: 1fr;
    }
    .author-box {
      grid-template-columns: 64px 1fr;
      gap: 16px;
    }
    .author-box :global(img) {
      width: 64px;
      height: 64px;
    }
    .more-head {
      padding: 36px 15px 20px;
    }
    .crumbs li[aria-current] {
      max-width: 28ch;
    }
  }
</style>
