---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SignupForm from "../../components/SignupForm.astro";
import portrait from "../../assets/portrait.webp";
import {
  getPosts,
  postCategory,
  postUrl,
  readingTime,
  relatedPosts,
  type Post,
} from "../../lib/blog";
import { categoryUrl } from "../../data/categories";
import { site } from "../../data/site";
import { formatDate } from "../../lib/http";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = await getPosts();
const minutes = readingTime(post.body);
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const chapters = headings.filter((h) => h.depth === 2);
// Long reads get a table of contents; short notes don't need one.
const showToc = chapters.length >= 5;
const related = relatedPosts(post, all, 3);
const category = postCategory(post);
const categoryHref = categoryUrl(category.slug);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const canonical = `${origin}${postUrl(post)}`;
const absolute = (src?: string) => (src ? new URL(src, `${origin}/`).href : undefined);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: absolute(post.data.socialImage ?? post.data.image),
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      "@type": "Person",
      name: site.author.name,
      url: `${origin}/#author`,
      jobTitle: site.author.role,
    },
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: `${origin}/`,
      logo: { "@type": "ImageObject", url: `${origin}/brand/next-chapter-192.png` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    articleSection: category.name,
    keywords: post.data.tags.join(", ") || undefined,
    wordCount: words,
    isAccessibleForFree: true,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${origin}/blog` },
      { "@type": "ListItem", position: 3, name: category.name, item: `${origin}${categoryHref}` },
      { "@type": "ListItem", position: 4, name: post.data.title, item: canonical },
    ],
  },
];
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  current="Articles"
  image={post.data.socialImage ?? post.data.image}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
    section: category.name,
  }}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class:list={["container post-grid", { "with-toc": showToc, "with-hero": post.data.image }]}>
      <header class="post-head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/blog">Articles</a></li>
            <li><a href={categoryHref}>{category.name}</a></li>
          </ol>
        </nav>
        <h1>{post.data.title}</h1>
        <p class="standfirst">{post.data.description}</p>
        <div class="byline">
          <Image
            src={portrait}
            alt=""
            width={44}
            height={44}
            widths={[44, 88]}
            sizes="44px"
            loading="eager"
          />
          <p>
            <span class="byline-name">
              By <a href="/#author">{site.author.name}</a>
            </span>
            <span class="byline-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.updatedDate && (
                <Fragment>
                  {" "}· Updated{" "}
                  <time datetime={post.data.updatedDate.toISOString()}>
                    {formatDate(post.data.updatedDate)}
                  </time>
                </Fragment>
              )}
              {" "}· {minutes} min read
            </span>
          </p>
        </div>
      </header>

      {post.data.image && (
        <figure class="post-hero">
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      {showToc && (
        <aside class="toc" aria-label="In this article">
          <details open data-toc>
            <summary>In this article</summary>
            <ol>
              {chapters.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </aside>
      )}

      <div class="post-body">
        {post.data.takeaways && post.data.takeaways.length > 0 && (
          <aside class="takeaways" aria-labelledby="takeaways-heading">
            <p class="takeaways-heading" id="takeaways-heading">Key takeaways</p>
            <ul>
              {post.data.takeaways.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </aside>
        )}
        <div class="prose" data-prose>
          <Content />
        </div>
      </div>

      <footer class="post-foot">
        {post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Topics">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
        <div class="author-box">
          <Image
            src={portrait}
            alt=""
            width={80}
            height={80}
            widths={[80, 160]}
            sizes="80px"
            loading="lazy"
          />
          <div>
            <p class="author-label">Written by</p>
            <p class="author-name">{site.author.name}</p>
            <p class="author-bio">{site.author.bio}</p>
            <a href="/contact" class="arrow-link">Ask a question →</a>
          </div>
        </div>
      </footer>
    </div>
  </article>

  <div class="container post-after">
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">Keep reading</p>
            <h2 id="related-heading">Related articles</h2>
          </div>
          <a href={categoryHref} class="arrow-link">
            All {category.name} articles →
          </a>
        </div>
        <div class="card-grid">
          {related.map((p) => (
            <ArticleCard post={p} />
          ))}
        </div>
      </section>
    )}

    <section class="post-signup">
      <div class="signup-box">
        <div>
          <p class="eyebrow">Newsletter</p>
          <h2>Get the next one.</h2>
          <p>
            One email when a new article is published. A couple a month at most,
            one click to leave.
          </p>
        </div>
        <SignupForm source={`blog:${post.id}`.slice(0, 40)} />
      </div>
    </section>
  </div>
</Base>

<script>
  // Highlight the chapter being read in the table of contents.
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    .forEach((a) => links.set(a.dataset.tocLink!, a));
  if (links.size && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const order = [...links.keys()];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const current = order.find((id) => visible.has(id));
        if (!current) return;
        links.forEach((a, id) =>
          a.toggleAttribute("aria-current", id === current),
        );
      },
      { rootMargin: "-90px 0px -65% 0px" },
    );
    order.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // On narrow screens the table of contents starts closed and closes after a jump.
  const toc = document.querySelector<HTMLDetailsElement>("[data-toc]");
  if (toc) {
    const narrow = window.matchMedia("(max-width: 1100px)");
    if (narrow.matches) toc.open = false;
    toc.addEventListener("click", (event) => {
      if (narrow.matches && (event.target as Element).closest("a")) toc.open = false;
    });
  }

  // A copy button on every code block, for the prompt templates.
  document.querySelectorAll<HTMLPreElement>("[data-prose] pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    pre.replaceWith(wrap);
    wrap.appendChild(pre);
    wrap.appendChild(button);
  });
</script>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 720px);
    grid-template-areas:
      "head"
      "hero"
      "toc"
      "body"
      "foot";
    justify-content: center;
    padding-top: clamp(28px, 5vw, 56px);
  }
  .post-head {
    grid-area: head;
  }
  .post-hero {
    grid-area: hero;
  }
  .toc {
    grid-area: toc;
  }
  .post-body {
    grid-area: body;
    min-width: 0;
  }
  .post-foot {
    grid-area: foot;
  }
  @media (min-width: 1101px) {
    .post-grid.with-toc {
      grid-template-columns: minmax(0, 720px) 250px;
      column-gap: 64px;
      grid-template-areas:
        "head ."
        "hero hero"
        "body toc"
        "foot .";
    }
  }

  /* Header */
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 18px;
    padding: 0;
    font-size: 14px;
  }
  .crumbs li {
    display: inline-flex;
    gap: 6px;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: "/";
    color: var(--faint);
  }
  .crumbs a {
    color: var(--text-2);
  }
  .crumbs li:last-child a {
    color: var(--accent-text);
    font-weight: 600;
  }
  .crumbs a:hover {
    color: var(--accent-hover);
  }
  .post-head h1 {
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .standfirst {
    margin: 18px 0 0;
    font-size: clamp(18px, 1.7vw, 21px);
    line-height: 1.55;
    color: var(--text-2);
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding-bottom: 4px;
  }
  .byline :global(img) {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .byline p {
    margin: 0;
    display: grid;
    gap: 2px;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .byline-name {
    color: var(--text);
    font-weight: 600;
  }
  .byline-name a {
    color: var(--ink);
  }
  .byline-meta {
    color: var(--muted);
  }

  /* Hero */
  .post-hero {
    margin: clamp(28px, 4vw, 40px) 0 0;
  }
  .post-hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid var(--border);
  }

  /* Body */
  .post-body {
    padding-top: clamp(28px, 4vw, 44px);
  }
  .takeaways {
    margin: 0 0 clamp(28px, 4vw, 40px);
    padding: 20px 24px;
    background: var(--tint);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .takeaways-heading {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }
  .takeaways ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  .takeaways li {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text);
  }
  .takeaways li::marker {
    color: var(--accent-text);
  }
  .post-body :global(.code-wrap) {
    position: relative;
  }
  .post-body :global(.copy-code) {
    position: absolute;
    top: 10px;
    right: 10px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 10px;
    border: 1px solid var(--border-2);
    border-radius: 8px;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .post-body :global(.copy-code:hover) {
    border-color: var(--ink);
  }

  /* Table of contents */
  .toc {
    padding-top: clamp(28px, 4vw, 44px);
  }
  .toc details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 4px 16px;
  }
  .toc summary {
    list-style: none;
    cursor: pointer;
    padding: 12px 0;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary::after {
    content: "+";
    color: var(--accent-text);
    font-size: 18px;
    line-height: 1;
  }
  .toc details[open] summary::after {
    content: "–";
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 12px;
  }
  .toc a {
    display: block;
    padding: 6px 0 6px 12px;
    border-left: 2px solid var(--border);
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--text-2);
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }
  @media (min-width: 1101px) {
    .toc details {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      max-height: calc(100vh - var(--header-h) - 48px);
      overflow-y: auto;
    }
  }

  /* Footer */
  .post-foot {
    padding: 36px 0 clamp(40px, 6vw, 64px);
  }
  .post-foot .tag-list {
    margin: 0 0 28px;
  }
  .author-box {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    align-items: start;
    padding: 24px;
    background: var(--bg-alt);
    border-radius: var(--radius);
  }
  .author-box :global(img) {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }
  .author-label {
    margin: 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .author-name {
    margin: 2px 0 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .author-bio {
    margin: 0 0 12px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
  }

  /* After the article */
  .post-after {
    border-top: 1px solid var(--border);
  }
  .related {
    padding: clamp(40px, 6vw, 64px) 0 0;
  }
  .post-signup {
    padding: clamp(40px, 6vw, 64px) 0;
  }

  @media (max-width: 600px) {
    .author-box {
      grid-template-columns: 1fr;
    }
  }
</style>
