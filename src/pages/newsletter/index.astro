---
/**
 * Newsletter landing + status page (?status=check|confirmed|unsubscribed|invalid).
 */
import Base from '../../layouts/Base.astro';
import SignupForm from '../../components/SignupForm.astro';
import { site } from '../../data/site';

export const prerender = false;
Astro.response.headers.set('cache-control', 'private, no-store');

const status = Astro.url.searchParams.get('status') ?? '';
const messages: Record<string, { title: string; text: string }> = {
  check: {
    title: 'One more click.',
    text: 'A confirmation email is on its way. Open it and click the link — nothing is sent until you do. If it does not arrive within a few minutes, check the spam folder.',
  },
  confirmed: {
    title: 'You are on the list.',
    text: 'Thank you. You will hear from me when a new article is published, and now and then with a short note. Every email has an unsubscribe link.',
  },
  unsubscribed: {
    title: 'Unsubscribed.',
    text: 'Your address has been removed. Nothing more will be sent. The articles stay free to read whenever you need them.',
  },
  invalid: {
    title: 'That link is not valid.',
    text: 'It may have been altered or it belongs to an address that is no longer on the list. Subscribe again below if you want to be.',
  },
};
const msg = messages[status];
---

<Base title="Newsletter" description="One email when a new free article is published, and now and then a short note. Nothing else." noindex={Boolean(msg)}>
  <div class="container wrap">
    <p class="eyebrow">Newsletter</p>
    {
      msg ? (
        <Fragment>
          <h1 class="display">{msg.title}</h1>
          <p class="lead">{msg.text}</p>
          {(status === 'invalid' || status === 'unsubscribed') && (
            <div class="panel form-panel">
              <SignupForm redirect="/newsletter?status=check" source="newsletter-page" />
            </div>
          )}
          <p class="small links">
            <a href="/blog">Read the articles →</a>
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="display">Hear when the next one is out.</h1>
          <p class="lead">
            {site.upcoming.length} more long reads are on the writing desk. Subscribe and you get one email on the day
            an article is published, plus the occasional short note about something learned building
            with AI. Never more than a couple a month, and everything stays free to read.
          </p>
          <ul class="upcoming">
            {site.upcoming.map((item) => (
              <li><strong>{item.title}</strong> — {item.text}</li>
            ))}
          </ul>
          <div class="panel form-panel">
            <SignupForm redirect="/newsletter?status=check" source="newsletter-page" />
          </div>
          <p class="small links">
            No sequences, no sales. Questions: <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </Fragment>
      )
    }
  </div>
</Base>

<style>
  .wrap { padding-top: clamp(40px, 7vw, 80px); padding-bottom: clamp(56px, 8vw, 104px); max-width: 760px; }
  h1 { font-size: clamp(34px, 5vw, 50px); line-height: 1.1; margin: 10px 0 16px; }
  .lead { margin: 0 0 28px; }
  .form-panel { padding: 28px; }
  .links { margin-top: 20px; }
  .upcoming { margin: 0 0 32px; padding-left: 20px; color: var(--text); line-height: 1.65; display: grid; gap: 10px; }
  .upcoming strong { color: var(--ink); font-weight: 600; }
</style>
