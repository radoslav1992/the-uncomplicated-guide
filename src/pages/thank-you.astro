---
/**
 * Stripe returns the buyer here (success_url) with ?session_id=cs_...
 * Access requires the checkout browser cookie or the signed-in owner.
 * A session id alone never reveals buyer details or signs anyone in.
 */
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { getGuide } from '../data/guides';
import { site, formatPrice } from '../data/site';
import { stripeConfigured, retrieveSession } from '../lib/stripe';
import { activePurchase, ensurePurchase, getPurchase, linkExpired, linkExpiresAt, reissueToken, type Purchase } from '../lib/purchases';
import { canAccessOrder } from '../lib/session';
import { formatDate } from '../lib/http';

export const prerender = false;

Astro.response.headers.set('cache-control', 'private, no-store');

const sessionId = Astro.url.searchParams.get('session_id')?.trim() ?? '';
const resent = Astro.url.searchParams.get('resent') === '1';
const error = Astro.url.searchParams.get('error');

type State = 'ok' | 'missing' | 'unpaid' | 'notfound' | 'unavailable' | 'signin';
let state: State = 'missing';
let purchase: Purchase | null = null;
let reissued = false;

if (sessionId) {
  try {
    purchase = await getPurchase(env, sessionId);
    if (purchase && !(await canAccessOrder(Astro, env, sessionId, purchase.email))) {
      purchase = null; state = 'signin';
    } else if (activePurchase(purchase)) {
      if (linkExpired(purchase)) {
        purchase = await reissueToken(env, purchase);
        reissued = true;
      }
      state = 'ok';
    } else if (stripeConfigured(env)) {
      const session = await retrieveSession(env, sessionId);
      if (!(await canAccessOrder(Astro, env, sessionId, session.customer_details?.email ?? session.customer_email ?? ''))) {
        state = 'signin';
      } else {
      purchase = await ensurePurchase(env, session);
      state = purchase ? 'ok' : session.payment_status === 'paid' ? 'notfound' : 'unpaid';
      }
    } else {
      state = 'unavailable';
    }
  } catch (err) {
    console.error('[thank-you] lookup failed', err);
    state = 'notfound';
  }
}

// A checkout id never grants access to the buyer's account.
if (state !== 'ok') purchase = null;

const guide = purchase ? getGuide(purchase.guide) : undefined;
const downloadHref = purchase ? `/download/${purchase.token}` : '';
const validUntil = purchase ? formatDate(linkExpiresAt(purchase)) : '';
const title = state === 'ok' ? 'Thank you — your guide is ready' : 'Your purchase';
---

<Base title={title} noindex current="">
  <div class="container wrap">
    {state === 'signin' && <div class="single"><p class="eyebrow">Your purchase</p><h1 class="display">Find your guide in your inbox.</h1><p class="lead">For your privacy, open the delivery email or sign in with the email used at checkout.</p><a href="/account" class="btn btn-accent">Open My guides →</a></div>}
    {
      state === 'ok' && purchase && (
        <div class="grid">
          <div>
            <p class="eyebrow">Payment received</p>
            <h1 class="display">Thank you. Here is your guide.</h1>
            <p class="lead">
              <strong>{guide?.title ?? purchase.guide}</strong>
              {guide?.pages && ` · ${guide.pages} pages · PDF`}
              {purchase.amount_total > 0 && ` · ${formatPrice(purchase.amount_total, purchase.currency)}`}
            </p>
            <a href={downloadHref} class="btn btn-accent dl" download>Download the PDF →</a>
            <p class="small validity">
              Link valid until {validUntil}. {reissued && 'The previous link had expired, so a fresh one was issued. '}
              Sign in to My guides whenever you need a fresh link.
            </p>

            <div class="card next">
              <p class="h">Your download email</p>
              <p>
                {purchase.emailed_at ? 'Sent to' : 'Delivery is being processed for'} <strong>{purchase.email}</strong>. If it does not arrive
                within a few minutes, check the spam folder or send it again:
              </p>
              <form method="post" action="/api/resend-link" class="resend">
                <input type="hidden" name="session_id" value={purchase.session_id} />
                <button type="submit" class="btn btn-outline">Send the link again</button>
                {resent && <span class="notice-ok">Queued. Give it a few minutes.</span>}
                {error && <span class="notice-error">{error}</span>}
              </form>
              <p class="small">Your Stripe receipt comes separately, to the same address.</p>
            </div>
          </div>
          <aside>
            <div class="card">
              <p class="h">Keep it</p>
              <p>Read and print on all your devices. Use the checklists and templates with your own clients. Only the file itself is not shared or resold.</p>
            </div>
            <div class="card">
              <p class="h">Something wrong?</p>
              <p>
                Write to <a href={`mailto:${site.email}`}>{site.email}</a> from the address you paid with. Download problems are fixed the same day; the <a href="/refunds">refund policy</a> covers the rest.
              </p>
            </div>
            <div class="card">
              <p class="h">When you have read it</p>
              <p>
                A review from someone who actually used the guide helps the next reader more than
                anything I can write. Leave one from <a href="/account?review=1#reviews">your account</a>,
                good or bad.
              </p>
            </div>
            <p class="small">Lost the link later? Sign in at <a href="/account">your account</a> with this email and download it again.</p>
            <a href="/guides" class="arrow-link">See what is coming next →</a>
          </aside>
        </div>
      )
    }

    {
      state === 'missing' && (
        <div class="single">
          <p class="eyebrow">Purchase</p>
          <h1 class="display">Looking for your download?</h1>
          <p class="lead">
            Open the link in the email you received after paying, or sign in at My guides with your purchase email. If you have neither, write to{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a> from the address you paid with.
          </p>
          <a href="/guides" class="btn btn-outline">Back to the library</a>
        </div>
      )
    }

    {
      state === 'unpaid' && (
        <div class="single">
          <p class="eyebrow">Purchase</p>
          <h1 class="display">The payment has not completed yet.</h1>
          <p class="lead">
            Stripe has not confirmed the payment for this checkout. If you paid with a bank method that takes a
            while, come back to this page in a few minutes. Otherwise start again from the guide page.
          </p>
          <a href="/guides" class="btn btn-accent">Back to the library</a>
        </div>
      )
    }

    {
      (state === 'notfound' || state === 'unavailable') && (
        <div class="single">
          <p class="eyebrow">Purchase</p>
          <h1 class="display">Could not find that purchase.</h1>
          <p class="lead">
            The link may be incomplete, or the shop is still being set up. Write to{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a> with the email you paid with and I will send the file
            directly.
          </p>
          <a href="/contact" class="btn btn-accent">Contact</a>
        </div>
      )
    }
  </div>
</Base>

<style>
  .wrap {
    padding-top: 76px;
    padding-bottom: 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: start;
  }
  h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 12px 0 14px;
  }
  .lead {
    margin: 0 0 26px;
    max-width: 56ch;
  }
  .dl {
    font-size: 17px;
    padding: 17px 30px;
  }
  .validity {
    margin: 14px 0 0;
    max-width: 48ch;
  }
  .next {
    margin-top: 32px;
  }
  .card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
    margin: 0 0 14px;
  }
  .card p:last-child {
    margin-bottom: 0;
  }
  .card .h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .resend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
  }
  .resend .btn {
    padding: 12px 20px;
    font-size: 14.5px;
  }
  aside {
    display: grid;
    gap: 14px;
    padding-top: 24px;
  }
  .single {
    max-width: 640px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .wrap {
      padding-top: 48px;
      padding-bottom: 64px;
    }
    aside {
      padding-top: 0;
    }
  }
</style>
