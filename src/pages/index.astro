---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import SignupForm from "../components/SignupForm.astro";
import portrait from "../assets/portrait.webp";
import { site } from "../data/site";
import {
  categoriesWithPosts,
  getPosts,
  postUrl,
} from "../lib/blog";

const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured);
// Featured articles already lead the page; the latest list shows the rest.
const latest = posts.filter((post) => !post.data.featured).slice(0, 6);
const categories = categoriesWithPosts(posts);

const origin = site.url;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: `${origin}/`,
    description: site.description,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: site.name,
    url: `${origin}/blog`,
    description: site.description,
    author: { "@type": "Person", name: site.author.name, url: `${origin}/#author` },
    blogPost: posts.slice(0, 10).map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: `${origin}${postUrl(post)}`,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
];
---

<Base
  title="Practical articles on AI receptionists, AI video and AI side projects"
  description={site.description}
  current="Home"
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="home-hero">
      <div>
        <p class="eyebrow">Free to read · No paywall · No sign-up</p>
        <h1>
          Practical AI guides, <em>without the noise.</em>
        </h1>
        <p class="lead">
          Step-by-step articles and field notes on AI receptionists, AI video
          ads and side projects built with AI: what to build, what it costs, and
          what breaks before a client finds out.
        </p>
        <div class="hero-actions">
          <a href="#featured" class="btn btn-accent">Start reading</a>
          <a href="/blog" class="btn btn-outline">Browse all articles</a>
        </div>
      </div>
      {categories.length > 0 && (
        <nav class="topics-box" aria-label="Browse by topic">
          <p>Browse by topic</p>
          <ul>
            {categories.map((category) => (
              <li>
                <a href={category.url}>
                  <span class="topic-name">
                    {category.name}
                    <span class="topic-count">
                      {category.posts.length}
                      {category.posts.length === 1 ? " article" : " articles"}
                    </span>
                  </span>
                  <span class="topic-desc">{category.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>

    {featured.length > 0 && (
      <section id="featured" class="home-section" aria-labelledby="featured-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">Featured</p>
            <h2 id="featured-heading">Long reads, start to finish</h2>
          </div>
          <a href="/blog" class="arrow-link">All articles →</a>
        </div>
        <div class="featured-grid">
          {featured.slice(0, 2).map((post) => (
            <FeaturedArticle post={post} />
          ))}
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section id="latest" class="home-section" aria-labelledby="latest-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2 id="latest-heading">Recent articles</h2>
          </div>
          <a href="/blog" class="arrow-link">All articles →</a>
        </div>
        <div class="card-grid">
          {latest.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      </section>
    )}

    <section id="author" class="home-section" aria-labelledby="author-heading">
      <div class="author-block">
        <Image
          src={portrait}
          alt={site.author.name}
          widths={[220, 440]}
          sizes="220px"
          loading="lazy"
        />
        <div>
          <p class="eyebrow">About the author</p>
          <h2 id="author-heading">Hello, I’m {site.author.name}.</h2>
          <p>
            I teach generative AI and natural language processing at university
            and am a PhD candidate in computer science. I run a software studio
            in Sofia, building voice agents, automations and internal systems.
          </p>
          <p>
            The articles here collect the decisions, checks and commercial
            considerations behind that work — the parts that rarely make it into
            a tutorial. They are free to read and free to use in your own
            projects.
          </p>
          <a href="/contact" class="arrow-link">Ask a question or suggest a topic →</a>
        </div>
      </div>
    </section>

    <section id="signup" class="home-section">
      <div class="signup-box">
        <div>
          <p class="eyebrow">Newsletter</p>
          <h2>The next useful article, in your inbox.</h2>
          <p>
            One email when a new article is published. No sequences, no sales,
            and one click to leave.
          </p>
        </div>
        <div>
          <SignupForm source="home" buttonLabel="Subscribe" />
          <p class="small">A confirmation email keeps the choice yours.</p>
        </div>
      </div>
    </section>
  </div>
</Base>
