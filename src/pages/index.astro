---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import GuideCard from "../components/GuideCard.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import SignupForm from "../components/SignupForm.astro";
import portrait from "../assets/portrait.webp";
import { site } from "../data/site";
import { availableGuides } from "../data/guides";
import { getPosts, postUrl, readingTime } from "../lib/blog";
const featured = availableGuides.slice(0, 2);
const posts = (await getPosts()).filter((post) => !post.data.draft).slice(0, 3);
const FAQ = [
  {
    q: "What do I get?",
    a: "An English PDF with planning frameworks, prompts, checklists and business examples. AI Assistants is 36 pages; AI Video Ads & UGC is 35. Read three real sample pages before choosing. Software subscriptions, runnable integrations and video project files are not included.",
  },
  {
    q: "How do I get my download?",
    a: "Pay once through Stripe, then download your PDF. We also email the link. If a link expires, sign in to My guides with your purchase email to get another.",
  },
  {
    q: "Can I use the material with clients?",
    a: "Yes. Use the prompts, checklists and templates in your own work and with your clients. Your licence does not allow sharing or reselling the PDF itself.",
  },
  {
    q: "What about refunds?",
    a: "Checkout asks for your express consent to immediate digital delivery. Statutory rights for faulty or misdescribed content remain. Our additional 14-day not-as-described promise and full refund terms are on the Refund policy page.",
  },
  {
    q: "Are the tools kept current?",
    a: "These editions are dated 1 September 2026. Tool prices, features and platform rules can change, so follow the official source links before committing a client budget. Future revisions within the same 1.x edition are included when published.",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
};
---

<Base
  title="Practical playbooks for AI services"
  current="Home"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-enter">
          <span class="eyebrow-line"></span>Independent guides. Practical
          thinking.
        </p>
        <h1 class="hero-enter" style="--delay:80ms">
          A little reading.
          <br />A lot of <em>doing.</em>
        </h1>
        <p class="hero-description hero-enter" style="--delay:160ms">
          Turn your next AI idea into a plan you can put to work. Clear,
          practical playbooks for building voice assistants and creating AI
          video ads.
        </p>
        <div class="hero-actions hero-enter" style="--delay:240ms">
          <a href="#guides" class="btn btn-accent">
            Find your next guide <Icon name="arrow" size={19} />
          </a>
          <a href="#approach" class="how-link">
            A look inside <span>↗</span>
          </a>
        </div>
        <div class="hero-note hero-enter" style="--delay:320ms">
          <span class="note-icon">
            <Icon name="book" size={20} />
          </span>
          <p>
            <strong>Made to be used. Not just read.</strong>
            <br />
            PDF playbooks · One payment · Yours to keep
          </p>
        </div>
      </div>
      <div class="book-stage" aria-label="Featured guides">
        <div class="stage-disc" aria-hidden="true"></div>
        <div class="stage-orbit" aria-hidden="true"></div>
        <span class="stage-spark" aria-hidden="true">
          <Icon name="spark" size={42} />
        </span>
        <span class="edition-note">THE PRACTICAL COLLECTION / 01</span>
        {featured.map((guide, i) => (
          <a
            class:list={["hero-book", `hero-book-${i}`]}
            href={`/guides/${guide.slug}`}
            aria-label={`Explore ${guide.title}`}
          >
            {guide.cover && (
              <Image
                src={guide.cover}
                alt={`${guide.title} cover`}
                widths={[300, 600]}
                sizes="(max-width: 560px) 42vw, (max-width: 900px) 240px, 260px"
                loading="eager"
                fetchpriority={i === 0 ? "high" : "auto"}
              />
            )}
          </a>
        ))}
        <div class="sample-note">
          <span>
            <Icon name="book" size={22} />
          </span>
          <p>
            Curious? Take a look.
            <br />
            <strong>Free sample pages in every guide.</strong>
          </p>
        </div>
        <span class="stage-caption">Small books. Useful ideas.</span>
      </div>
    </div>
  </section>
  <div class="benefits">
    <div class="container benefits-grid">
      <div>
        <Icon name="book" />
        <span>
          <strong>Preview before you buy</strong>
          <small>Real pages, no email needed</small>
        </span>
      </div>
      <div>
        <Icon name="download" />
        <span>
          <strong>Read it your way</strong>
          <small>Download, save, and print your PDF</small>
        </span>
      </div>
      <div>
        <Icon name="check" />
        <span>
          <strong>One simple purchase</strong>
          <small>No recurring subscription</small>
        </span>
      </div>
    </div>
  </div>
  <section id="guides" class="container shelf">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">The bookshelf</p>
        <h2>
          What will you build <em>next?</em>
        </h2>
      </div>
      <a href="/guides" class="arrow-link">
        Explore the library <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="cards">
      {availableGuides.map((guide) => (
        <div data-reveal>
          <GuideCard guide={guide} />
        </div>
      ))}
    </div>
    <p class="shelf-footnote">
      <Icon name="check" size={16} /> Every guide includes a free sample. Find
      your fit before you buy.
    </p>
  </section>
  <section id="approach" class="approach">
    <div class="container approach-grid">
      <div data-reveal>
        <p class="eyebrow">From the first page to the next step</p>
        <h2>
          A guide with
          <br />
          some <em>follow-through.</em>
        </h2>
        <p class="approach-intro">
          The tools are only part of the story. These playbooks help you think
          through the decisions, costs, and checks around them.
        </p>
        <a href="/guides" class="arrow-link">
          See what’s inside <Icon name="arrow" size={18} />
        </a>
      </div>
      <ol class="steps">
        <li data-reveal>
          <span class="step-number">01</span>
          <div>
            <h3>Find the right project.</h3>
            <p>
              Work out who it helps, what it needs, and whether the numbers make
              sense.
            </p>
          </div>
          <Icon name="spark" size={23} />
        </li>
        <li data-reveal>
          <span class="step-number">02</span>
          <div>
            <h3>Make a practical plan.</h3>
            <p>
              Follow the workflow. Adapt the prompts, planning tables, and
              checklists to your own work.
            </p>
          </div>
          <Icon name="book" size={23} />
        </li>
        <li data-reveal>
          <span class="step-number">03</span>
          <div>
            <h3>Think beyond the demo.</h3>
            <p>
              Plan how you’ll test it, price it, and support it when a real
              client starts using it.
            </p>
          </div>
          <Icon name="check" size={23} />
        </li>
      </ol>
    </div>
  </section>
  <section id="author" class="container author-section">
    <div class="portrait-frame" data-reveal>
      <div class="portrait-mat">
        <Image
          src={portrait}
          alt={site.author.name}
          widths={[400, 800]}
          sizes="(max-width: 760px) 85vw, 400px"
          loading="lazy"
        />
      </div>
      <span class="portrait-label">
        The person behind the pages <Icon name="arrow" size={22} />
      </span>
    </div>
    <div class="author-copy" data-reveal>
      <p class="eyebrow">Written from experience</p>
      <h2>
        Hello, I’m
        <br />
        <em>{site.author.name}.</em>
      </h2>
      <p>
        I teach generative AI and natural language processing at university and
        am a PhD candidate in computer science. I run a software studio in
        Sofia, building voice agents, automations, and internal systems.
      </p>
      <p>
        These guides collect the decisions, checks, and commercial
        considerations behind that work. A useful companion for your next
        project, with room for your own judgement.
      </p>
      <div class="author-signoff">
        <span>{site.author.name}</span>
        <small>Author · Software & AI engineer</small>
      </div>
      <a href="/contact" class="arrow-link">
        Ask me about a guide <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
  {posts.length > 0 && (
    <section class="journal">
      <div class="container">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">A few pages from the notebook</p>
            <h2>
              Notes from <em>the work.</em>
            </h2>
          </div>
          <a href="/blog" class="arrow-link">
            All articles <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="journal-grid">
          {posts.map((post, i) => (
            <article class="journal-card" data-reveal>
              <div class="journal-meta">
                <span>{post.data.tags[0] || "Field notes"}</span>
                <span>{readingTime(post.body)} min read</span>
              </div>
              <span class="journal-number" aria-hidden="true">
                0{i + 1}
              </span>
              <h3>
                <a href={postUrl(post)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <a
                href={postUrl(post)}
                class="journal-link"
                aria-label={`Read ${post.data.title}`}
              >
                Read the note <Icon name="arrow" size={18} />
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="container faq-section">
    <div data-reveal>
      <p class="eyebrow">Good questions</p>
      <h2>
        Before you
        <br />
        <em>turn the page.</em>
      </h2>
      <p>
        Already have a guide?
        <br />
        <a href="/account">Find it in My guides ↗</a>
      </p>
    </div>
    <div data-reveal>
      <Faq items={FAQ} />
    </div>
  </section>
  <section id="signup" class="container signup-section">
    <div class="newsletter-panel" data-reveal>
      <div>
        <p class="eyebrow">Stay on the same page</p>
        <h2>
          The next useful idea.
          <br />
          <em>In your inbox.</em>
        </h2>
        <p>
          New guides and occasional notes from the work.
          <br />
          No sequences or last-chance offers. Unsubscribe anytime.
        </p>
      </div>
      <div class="newsletter-form">
        <Icon name="book" size={34} />
        <SignupForm source="home" buttonLabel="Keep me in the loop →" />
        <p class="small">A confirmation email keeps the choice yours.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero {
    position: relative;
    background: linear-gradient(105deg, #fcfaf5 25%, #f5eddd);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px;
    align-items: center;
    min-height: 650px;
    padding-top: 68px;
    padding-bottom: 72px;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .hero .eyebrow {
    font-size: 10px;
    letter-spacing: 0.13em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow-line {
    width: 25px;
    height: 1px;
    background: var(--accent);
    flex: none;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.06em;
    font-size: clamp(43px, 5.25vw, 70px);
    line-height: 1.09;
    margin: 25px 0;
  }
  em {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: -0.045em;
  }
  h1 em {
    color: var(--accent);
    font-size: 1.12em;
  }
  .hero-description {
    max-width: 470px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--text);
    margin: 0;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 30px;
  }
  .how-link {
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }
  .how-link span {
    margin-left: 10px;
  }
  .hero-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }
  .note-icon {
    height: 42px;
    width: 42px;
    border: 1px solid var(--border-2);
    display: grid;
    place-items: center;
    border-radius: 50%;
    flex: none;
  }
  .hero-note p {
    font-size: 11px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0;
  }
  .hero-note strong {
    font-weight: 500;
    color: var(--ink);
  }
  .book-stage {
    height: 490px;
    position: relative;
    isolation: isolate;
  }
  .stage-disc {
    position: absolute;
    width: 400px;
    max-width: 95%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #edc180;
    left: 8%;
    top: 10%;
    z-index: -2;
  }
  .stage-orbit {
    position: absolute;
    width: 440px;
    max-width: 105%;
    aspect-ratio: 1;
    border: 1px solid #cfb589;
    border-radius: 50%;
    top: 5%;
    left: 4%;
    z-index: -1;
    transform: rotate(-20deg) scaleY(0.93);
  }
  .stage-orbit::after {
    content: "";
    position: absolute;
    inset: -22px;
    border: 1px solid #cfb58977;
    border-radius: 50%;
  }
  .stage-spark {
    position: absolute;
    right: 0;
    top: 10px;
    color: var(--accent);
  }
  .edition-note {
    position: absolute;
    left: 12px;
    top: 3px;
    font-size: 9px;
    letter-spacing: 0.17em;
    color: var(--text);
  }
  .hero-book {
    display: block;
    position: absolute;
    width: 48%;
    max-width: 260px;
    box-shadow: 12px 26px 30px #182c3733;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    border-radius: 2px;
    transform-style: preserve-3d;
  }
  .hero-book::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #11243550,
      transparent 4%,
      #ffffff35 5%,
      transparent 8%
    );
    border-radius: 2px;
    pointer-events: none;
  }
  .hero-book::before {
    content: "";
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 100%;
    width: 9px;
    background: repeating-linear-gradient(
      90deg,
      #fffdf6 0 2px,
      #ded5c1 2px 3px
    );
    transform: skewY(25deg);
    transform-origin: left;
  }
  .hero-book img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .hero-book-0 {
    top: 56px;
    left: 7%;
    z-index: 2;
    transform: perspective(900px) rotateY(-12deg) rotate(-10deg);
  }
  .hero-book-1 {
    top: 115px;
    right: 2%;
    z-index: 3;
    transform: perspective(900px) rotateY(-12deg) rotate(10deg);
  }
  .hero-book-0:hover,
  .hero-book-0:focus-visible {
    transform: perspective(900px) rotateY(-4deg) rotate(-5deg) translateY(-12px);
    z-index: 4;
  }
  .hero-book-1:hover,
  .hero-book-1:focus-visible {
    transform: perspective(900px) rotateY(-4deg) rotate(5deg) translateY(-12px);
  }
  .sample-note {
    display: flex;
    gap: 10px;
    align-items: center;
    background: #fffdf8;
    border: 1px solid var(--border);
    box-shadow: 0 12px 26px #182c3710;
    border-radius: 10px;
    padding: 15px 18px;
    position: absolute;
    bottom: 3px;
    left: 0;
    z-index: 5;
  }
  .sample-note > span {
    color: var(--accent);
  }
  .sample-note p {
    font-size: 11px;
    line-height: 1.7;
    margin: 0;
    color: var(--muted);
  }
  .sample-note strong {
    font-size: 12px;
    color: var(--ink);
    font-weight: 500;
  }
  .stage-caption {
    position: absolute;
    right: 0;
    bottom: -25px;
    font-family: var(--font-editorial);
    font-size: 18px;
    font-style: italic;
    color: var(--text);
  }
  .benefits {
    background: #fffefa;
    border-block: 1px solid var(--border);
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: 25px;
  }
  .benefits-grid > div {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }
  .benefits-grid > div + div {
    border-left: 1px solid var(--border);
  }
  .benefits-grid :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .benefits strong,
  .benefits small {
    display: block;
  }
  .benefits strong {
    font-size: 13px;
    font-weight: 550;
  }
  .benefits small {
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
  }
  .shelf {
    padding-top: 86px;
    padding-bottom: 70px;
    scroll-margin-top: 100px;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(29px, 3.6vw, 44px);
    line-height: 1.13;
    letter-spacing: -0.045em;
    margin: 12px 0 0;
  }
  h2 em {
    font-size: 1.08em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .cards > div {
    display: flex;
  }
  .cards :global(.guide-card) {
    width: 100%;
  }
  .shelf-footnote {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 12px;
  }
  .shelf-footnote :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .approach {
    padding: 80px 0;
    background: #edf1ec;
    border-block: 1px solid #d9e1d9;
    scroll-margin-top: 80px;
  }
  .approach-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 85px;
    align-items: center;
  }
  .approach-intro {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    max-width: 370px;
    margin: 23px 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr 24px;
    gap: 18px;
    padding: 25px 0;
    border-top: 1px solid #ced8ce;
  }
  .steps li:last-child {
    border-bottom: 1px solid #ced8ce;
  }
  .step-number {
    font-size: 14px;
    color: var(--accent);
    padding-top: 4px;
  }
  .steps h3 {
    font-size: 20px;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .steps p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text);
    margin: 0;
  }
  .steps :global(svg) {
    color: var(--accent);
    margin-top: 4px;
  }
  .author-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 95px;
    align-items: center;
    padding-block: 100px;
    scroll-margin-top: 80px;
  }
  .portrait-frame {
    position: relative;
    padding: 22px 22px 0;
    background: #eee4d4;
    border-radius: 180px 180px 12px 12px;
    max-width: 420px;
  }
  .portrait-mat {
    overflow: hidden;
    border-radius: 165px 165px 3px 3px;
  }
  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .portrait-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 19px 3px;
    font-size: 11px;
    color: var(--ink);
  }
  .author-copy > p:not(.eyebrow) {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    margin: 22px 0;
  }
  .author-signoff {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    margin-top: 26px;
    margin-bottom: 20px;
  }
  .author-signoff span {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 25px;
  }
  .author-signoff small {
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .journal {
    background: var(--bg-alt);
    padding: 76px 0;
  }
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .journal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-2);
    padding: 26px;
    border-radius: 12px;
    background: var(--bg);
    transition: background 0.3s;
  }
  .journal-card:hover {
    background: white;
  }
  .journal-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .journal-number {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 52px;
    line-height: 1;
    color: #9c8060;
    margin-top: 32px;
  }
  .journal-card h3 {
    font-size: 21px;
    line-height: 1.35;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 20px 0 12px;
  }
  .journal-card h3 a {
    color: var(--ink);
  }
  .journal-card p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--text);
