---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import SignupForm from '../components/SignupForm.astro';
import portrait from '../assets/portrait.webp';
import { site } from '../data/site';
import { availableGuides } from '../data/guides';
const FAQ = [
 {q:'What do I get?',a:'An English PDF with planning frameworks, prompts, checklists and business examples. AI Assistants is 36 pages; AI Video Ads & UGC is 35. Read three real sample pages before choosing. Software subscriptions, runnable integrations and video project files are not included.'},
 {q:'How do I get my download?',a:'Pay once through Stripe, then download your PDF. We also email the link. If a link expires, sign in to My guides with your purchase email to get another.'},
 {q:'Can I use the material with clients?',a:'Yes. Use the prompts, checklists and templates in your own work and with your clients. Your licence does not allow sharing or reselling the PDF itself.'},
 {q:'What about refunds?',a:'Checkout asks for your express consent to immediate digital delivery. Statutory rights for faulty or misdescribed content remain. Our additional 14-day not-as-described promise and full refund terms are on the Refund policy page.'},
 {q:'Are the tools kept current?',a:'These editions are dated 1 September 2026. Tool prices, features and platform rules can change, so follow the official source links before committing a client budget. Future revisions within the same 1.x edition are included when published.'},
];
const jsonLd = {'@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.url};
---
<Base title="Practical playbooks for AI services" current="Home" jsonLd={jsonLd}>
  <section class="hero container">
    <p class="eyebrow">For people putting AI to work</p>
    <h1 class="display">Build with AI.<br /><span>Know the work.</span></h1>
    <div class="hero-bottom"><p>Practical playbooks for voice assistants and AI video ads. Understand the workflow, plan the costs and deliver a service you can support.</p><a href="#guides" class="btn btn-accent">Find your guide ↓</a></div>
    <div class="trust"><span>Two guides available</span><span>Free sample pages</span><span>$39 each · One payment</span></div>
  </section>
  <section id="guides" class="container shelf">
    <div class="section-heading"><div><p class="eyebrow">Choose your next project</p><h2 class="display">From an idea to a plan.</h2></div><a href="/guides" class="arrow-link">View the library →</a></div>
    <div class="cards">{availableGuides.map(guide => <GuideCard guide={guide} />)}</div>
  </section>
  <section class="section-dark approach"><div class="container approach-grid"><div><p class="eyebrow">The useful part</p><h2 class="display">Think beyond<br />the demo.</h2></div><div><p>The phone number. The hand-off between apps. The revision that wipes out your margin. These guides help you plan the work around the tools.</p><ul><li><strong>Decide.</strong> Choose a suitable project and define success.</li><li><strong>Build.</strong> Follow the workflow and adapt the prompts.</li><li><strong>Deliver.</strong> Check quality, price the work and support the client.</li></ul></div></div></section>
  <section id="author" class="section container author-grid">
    <Image src={portrait} alt={site.author.name} widths={[400,800]} sizes="(max-width: 720px) 80vw, 360px" loading="lazy" />
    <div><p class="eyebrow">Written by a practitioner</p><h2 class="display">Hello, I'm<br />{site.author.name}.</h2><p>I teach generative AI and natural language processing at university and am a PhD candidate in computer science. I run a software studio in Sofia, building voice agents, automations and internal systems.</p><p>These guides collect the decisions, checks and commercial considerations behind that work. Read a sample to see whether the level is right for you.</p><a href="/contact" class="arrow-link">Ask me about a guide →</a></div>
  </section>
  <section class="section-alt section"><div class="container faq-grid"><div><p class="eyebrow">Before you buy</p><h2 class="display">A few useful answers.</h2><p>Already bought a guide? <a href="/account">Open My guides →</a></p></div><Faq items={FAQ} /></div></section>
  <section id="signup" class="section container"><div class="panel signup-panel"><div><p class="eyebrow">New guides, occasional notes</p><h2 class="display">Hear when the next one ships.</h2><p>No sequences or last-chance offers. Unsubscribe from any email.</p></div><SignupForm source="home" /></div></section>
</Base>
<style>
.hero{padding-top:clamp(44px,6vw,80px);padding-bottom:32px}.hero h1{font-size:clamp(36px,6.7vw,78px);line-height:1.12;letter-spacing:-.055em;margin:18px 0 24px}.hero h1 span{color:var(--accent)}.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:32px}.hero-bottom p{max-width:640px;font-size:clamp(18px,2vw,21px);line-height:1.65;color:var(--text);margin:0}.hero-bottom .btn{flex:none}.trust{display:flex;gap:26px;flex-wrap:wrap;margin-top:30px;padding-top:22px;border-top:1px solid var(--border);color:var(--text);font-size:13px}.trust span::before{content:'✓';color:var(--accent);margin-right:8px}.shelf{padding-top:26px;padding-bottom:80px;scroll-margin-top:90px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}h2{font-size:clamp(25px,3vw,36px);line-height:1.25;letter-spacing:-.035em;margin:12px 0 20px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.approach{padding:72px 0}.approach-grid,.faq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px}.approach p{font-size:19px;color:var(--dark-body);line-height:1.7;margin-top:0}.approach ul{list-style:none;padding:0;margin:24px 0 0}.approach li{padding:14px 0;border-top:1px solid var(--border-dark);color:var(--dark-body)}.approach strong{color:var(--dark-text)}.author-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;align-items:center;scroll-margin-top:85px}.author-grid img{width:100%;max-width:360px;height:auto;border-radius:24px}.author-grid p{font-size:17px;line-height:1.75;color:var(--text)}.signup-panel{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center;padding:40px}.signup-panel p{color:var(--text)}@media(max-width:720px){.hero-bottom{align-items:flex-start;flex-direction:column;gap:22px}.hero-bottom .btn{width:100%}.trust{gap:12px;font-size:12px}.cards,.approach-grid,.author-grid,.faq-grid,.signup-panel{grid-template-columns:1fr;gap:28px}.shelf{padding-bottom:48px}.section-heading{align-items:start;flex-direction:column;gap:0}.author-grid img{max-width:280px}.signup-panel{padding:24px}.approach{padding:48px 0}}
</style>
