{
  "name": "the-uncomplicated-guides",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "npm run check:release && astro build && wrangler deploy",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply guides-db --local",
    "db:migrate": "wrangler d1 migrations apply guides-db --remote",
    "cf-typegen": "wrangler types",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "wrangler": "^4.129.0"
  }
}
