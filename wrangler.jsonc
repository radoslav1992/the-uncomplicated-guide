{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-uncomplicated-guides",
  // Custom entry: Astro's fetch handler + an `email` handler for Cloudflare Email Routing.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Newsletter delivery runs in batches; the cron continues any letter still sending.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Static pages are built as `page.html`; serve `/page` and redirect `/page/` → `/page`.
  // No `not_found_handling`: unmatched paths must fall through to the Worker (on-demand routes, 404 page).
  "assets": { "binding": "ASSETS", "html_handling": "drop-trailing-slash" },

  // ─── Plain configuration (not secret) ────────────────────────────────────
  "vars": {
    // Public URL of the deployed site (used for absolute links in emails).
    "SITE_URL": "https://uncomplicatedguide.com",
    // Sender for all outgoing mail. The domain must be verified in Cloudflare Email Service.
    "EMAIL_FROM": "hello@uncomplicatedguide.com",
    "EMAIL_FROM_NAME": "The Uncomplicated Guides",
    // Where contact-form messages and forwarded inbound mail go.
    // Must be a verified destination address in Cloudflare Email Routing (same inbox as kova.bg).
    "CONTACT_TO": "radoslav.dodnikov@gmail.com",
    // Analytics. Set ONE of the two; leave both empty to ship without analytics and without the cookie banner.
    // Nothing is loaded from Google until a visitor allows analytics in the banner.
    //  - Google Tag Manager container id (GTM-XXXXXXX). The container decides which tags run, so
    //    GA4 is configured inside Tag Manager. Wins when both are set.
    "PUBLIC_GTM_CONTAINER_ID": "GTM-M9K8ZPJC",
    //  - Google Analytics 4 measurement id (G-XXXXXXXXXX), loaded directly without Tag Manager.
    "PUBLIC_GA_MEASUREMENT_ID": "",
    // Optional: Cloudflare Turnstile site key for the contact form. Leave empty to disable.
    "PUBLIC_TURNSTILE_SITE_KEY": ""
  },

  // ─── Secrets (set with `wrangler secret put NAME`, locally in `.dev.vars`) ──
  // AUTH_SECRET              required; a long random string. Signs newsletter confirmation and
  //                          unsubscribe links. Generate with: openssl rand -base64 48
  // ADMIN_TOKEN              required to use /admin/newsletter; any long random string.
  // TURNSTILE_SECRET_KEY     optional, pairs with PUBLIC_TURNSTILE_SITE_KEY

  // ─── Storage ─────────────────────────────────────────────────────────────
  // D1: create the database in the dashboard (Storage & Databases → D1 → Create),
  // then paste its id into `database_id`. Apply `migrations/` with
  //   npx wrangler d1 migrations apply guides-db --remote
  // (the deploy command in the Workers Builds settings does this automatically).
  "d1_databases": [
    { "binding": "DB", "database_name": "guides-db", "database_id": "1257ef33-c0c0-4d12-b568-8629bc7fc0c8", "migrations_dir": "migrations" }
  ],
  // R2: the private bucket shared with kova.bg. Only objects under `article-images/` are
  // served (by src/pages/media/[...key].astro, as /media/article-images/<file>). The old
  // guide PDFs in this bucket are no longer read by anything — see docs/LAUNCH.md.
  "r2_buckets": [
    { "binding": "GUIDE_FILES", "bucket_name": "kova-guides" }
  ],

  // ─── Email (Cloudflare Email Service, beta) ───────────────────────────────
  // Sending: the binding below. Senders are restricted, recipients are not, so leaked
  // code cannot send mail from another address on the account's domains. The sending
  // domain must be verified in Email Service (like kova.bg is).
  // Receiving: in the dashboard, Email → Email Routing on the uncomplicatedguide.com zone →
  // route hello@ to this Worker; `src/worker.ts` forwards it to CONTACT_TO.
  "send_email": [
    { "name": "SEND_EMAIL", "allowed_sender_addresses": ["hello@uncomplicatedguide.com"] }
  ]
}
