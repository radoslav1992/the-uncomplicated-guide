# Copy to .dev.vars for local development (wrangler dev / astro dev).
# Production values are set with `wrangler secret put <NAME>`.

# Optional: Cloudflare Turnstile (pairs with PUBLIC_TURNSTILE_SITE_KEY in wrangler.jsonc)
TURNSTILE_SECRET_KEY=

# Required: a long random string. Signs newsletter confirmation and unsubscribe links.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Required for /admin/newsletter. Any long random string.
ADMIN_TOKEN=change-me-too

# Publisher disclosures shown on the imprint (also put them in .env for astro build).
SELLER_REGISTERED_ADDRESS=
SELLER_REGISTRATION_NUMBER=
SELLER_VAT_NUMBER=
